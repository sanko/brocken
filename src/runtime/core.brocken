# core.brocken -- Brocken v0.1 Runtime Primitives
# Automatically compiled alongside user code.
#
# Isolate Control Block (ICB) layout (80 bytes at heap_base):
#   [heap_base + 0]:  heap_cursor    (ptr - legacy simple-bump pointer, unused after Immix full deployment)
#   [heap_base + 8]:  current_fcb    (ptr - active Fiber Control Block, 0 = no fiber)
#   [heap_base + 16]: fiber_head     (ptr - head of fiber linked list)
#   [heap_base + 24]: immix_cursor   (ptr - current bump-allocation pointer within current line)
#   [heap_base + 32]: immix_limit    (ptr - end of current Immix line/block)
#   [heap_base + 40]: free_blocks    (ptr - free 32KB block list)
#   [heap_base + 48]: free16_head    (ptr - segregated free list for 16-byte reclaimed objects)
#   [heap_base + 56]: current_block  (ptr — the active Immix block being allocated from)
#   [heap_base + 64]: fuel           (i64 — remaining instruction budget, set by compiler)
#   [heap_base + 72]: err_code       (i64 — termination reason code, 0 = no error)
#
# First Immix block starts at heap_base + 80.
#
# Immix block layout (32 KB = 32768 bytes per block):
#   [block + 0..15]:     bitmap (128-bit line bitmap, bit N = line N in use)
#   [block + 16..255]:   Line 0  (240 usable bytes)
#   [block + 256..511]:  Line 1  (256 bytes)
#   ...
#   [block + 32512..32751]: Line 127 (240 usable bytes — last 16 bytes are metadata)
#   [block + 32752..32759]:  live_count (i64) — number of live allocations in block
#   [block + 32760..32767]:  next_free (i64) — next line index to start scanning for free lines
#   Total per block: 16 + 240 + 126*256 + 240 + 16 = 32768
#
# Objects freed by decref (when RC reaches 0) are pushed onto free16_head (offset 48).
# The next pointer is stored at [obj + 8] (payload area of the freed object).
# bump_alloc checks free16_head first (hot path), then falls back to line-aware
# bump allocation within the current Immix block (cold path).
# When the current block is full, free_blocks (offset 40) is consulted for recycling.
# When a block's live_count reaches 0, the entire block is recycled to free_blocks.

# Initialize ICB and Immix heap metadata.
# heap_base = address of ICB, first Immix block starts at heap_base + 80.
sub Brocken::Runtime::_init(ptr $heap_base, i64 $heap_size) {
    my ptr $block_base = Brocken::ptr_add($heap_base, 80);
    my ptr $line0_data = Brocken::ptr_add($block_base, 16);
    # Zero the block metadata: bitmap at [block+0..15], live_count at [block+32752],
    # next_free at [block+32760].
    Brocken::store_i64($block_base, 0);
    Brocken::store_i64(Brocken::ptr_add($block_base, 8), 0);
    Brocken::store_i64(Brocken::ptr_add($block_base, 32752), 0);
    Brocken::store_i64(Brocken::ptr_add($block_base, 32760), 0);
    # Mark Line 0 as in-use (it is the active allocation line)
    Brocken::Runtime::mark_line($block_base, 0);
    # legacy heap_cursor (offset 0)
    Brocken::store_i64($heap_base, $line0_data);
    # current_fcb (offset 8)
    Brocken::store_i64(Brocken::ptr_add($heap_base, 8), 0);
    # fiber_head (offset 16)
    Brocken::store_i64(Brocken::ptr_add($heap_base, 16), 0);
    # immix_cursor (offset 24) — start at first usable byte of line 0
    Brocken::store_i64(Brocken::ptr_add($heap_base, 24), $line0_data);
    # immix_limit (offset 32) = end of Line 0
    Brocken::store_i64(Brocken::ptr_add($heap_base, 32), Brocken::ptr_add($block_base, 256));
    # free_blocks (offset 40)
    Brocken::store_i64(Brocken::ptr_add($heap_base, 40), 0);
    # free16_head (offset 48)
    Brocken::store_i64(Brocken::ptr_add($heap_base, 48), 0);
    # current_block (offset 56) — the active Immix block starts at heap_base+80
    Brocken::store_i64(Brocken::ptr_add($heap_base, 56), $block_base);
    # fuel (offset 64) — initialized to 0, set by compiler entry prologue
    Brocken::store_i64(Brocken::ptr_add($heap_base, 64), 0);
    # err_code (offset 72) — 0 = no error
    Brocken::store_i64(Brocken::ptr_add($heap_base, 72), 0);
    return;
}

# Allocate $size bytes from the Immix-managed heap at $heap_base.
# Hot path: check segregated free list (free16_head at offset 48).
# Cold path: line-aware bump allocation within current Immix block.
#   - bumps immix_cursor (offset 24) within current line
#   - when line exhausted, advances to next free line via bitmap
#   - when block exhausted, sweeps bitmap for free lines before allocating new block
# Returns pointer to allocated memory, or 0 on out-of-memory.
sub Brocken::Runtime::bump_alloc(ptr $heap_base, i64 $size) -> ptr {
    # Hot path: free16_head at ICB offset 48
    my ptr $free16_ptr = Brocken::ptr_add($heap_base, 48);
    my ptr $head = Brocken::load_i64($free16_ptr);
    if (Brocken::ptr_cmp_eq($head, 0) == 0) {
        my ptr $next = Brocken::load_i64(Brocken::ptr_add($head, 8));
        Brocken::store_i64($free16_ptr, $next);
        return $head;
    }

    # Immix line-aware bump: load immix_cursor (offset 24) and immix_limit (offset 32)
    my ptr $cursor_ptr = Brocken::ptr_add($heap_base, 24);
    my ptr $cursor = Brocken::load_i64($cursor_ptr);
    my ptr $limit = Brocken::load_i64(Brocken::ptr_add($heap_base, 32));
    my ptr $new_cursor = Brocken::ptr_add($cursor, $size);

    # Does the allocation fit within the current line?
    if (Brocken::ptr_cmp_gt($new_cursor, $limit)) {
        # Current line exhausted. Find next free line via bitmap.
        my ptr $block_base_ptr = Brocken::ptr_add($heap_base, 56);
        my ptr $block_base = Brocken::load_i64($block_base_ptr);
        my i64 $offset_in_block = Brocken::ptr_sub($cursor, $block_base);
        # Current line index = offset >> 8
        my i64 $cur_line_idx = Brocken::shr($offset_in_block, 8);
        my i64 $next_scan = $cur_line_idx;
        # Use next_free hint if it is ahead of us
        my i64 $nf = Brocken::load_i64(Brocken::ptr_add($block_base, 32760));
        if (Brocken::ptr_cmp_gt($nf, $next_scan)) {
            $next_scan = $nf;
        }
        my i64 $found = Brocken::Runtime::find_free_line($block_base, $next_scan);
        if (Brocken::ptr_cmp_eq($found, -1) == 0) {
            # Found a free line — use it
            my i64 $line_byte_off = Brocken::shl($found, 8);
            my ptr $line_start = Brocken::ptr_add($block_base, $line_byte_off);
            my ptr $after_alloc = Brocken::ptr_add($line_start, $size);
            my ptr $block_end = Brocken::ptr_add($block_base, 32752);
            if (Brocken::ptr_cmp_gt($after_alloc, $block_end) == 0) {
                # Fits in the free line
                Brocken::store_i64($cursor_ptr, $after_alloc);
                my ptr $new_limit = Brocken::ptr_add($line_start, 256);
                Brocken::store_i64(Brocken::ptr_add($heap_base, 32), $new_limit);
                # Mark this line in the bitmap
                Brocken::Runtime::mark_line($block_base, $found);
                # Update next_free hint
                my i64 $next_nf = Brocken::i64_add($found, 1);
                Brocken::store_i64(Brocken::ptr_add($block_base, 32760), $next_nf);
                # Increment live_count
                my i64 $lc = Brocken::load_i64(Brocken::ptr_add($block_base, 32752));
                Brocken::store_i64(Brocken::ptr_add($block_base, 32752), Brocken::i64_add($lc, 1));
                return $line_start;
            }
            # Allocation too large for remaining space in that line — fall through
        }

        # No free line found in current block. Try free_blocks (offset 40).
        my ptr $free_blocks_ptr = Brocken::ptr_add($heap_base, 40);
        my ptr $fb = Brocken::load_i64($free_blocks_ptr);
        if (Brocken::ptr_cmp_eq($fb, 0) == 0) {
            # Free block available: pop it and switch to it
            my ptr $fb_next = Brocken::load_i64($fb);
            Brocken::store_i64($free_blocks_ptr, $fb_next);
            my ptr $fb_line0 = Brocken::ptr_add($fb, 16);
            Brocken::store_i64($cursor_ptr, $fb_line0);
            Brocken::store_i64($block_base_ptr, $fb);
            Brocken::store_i64(Brocken::ptr_add($heap_base, 32), Brocken::ptr_add($fb, 256));
            # Reset live_count and next_free for the reused block
            Brocken::store_i64(Brocken::ptr_add($fb, 32752), 1);
            Brocken::store_i64(Brocken::ptr_add($fb, 32760), 1);
            # Mark Line 0 in the reused block's bitmap
            Brocken::Runtime::mark_line($fb, 0);
            # Allocate from the new block
            Brocken::store_i64($cursor_ptr, Brocken::ptr_add($fb_line0, $size));
            return $fb_line0;
        }
        # No free block available. Allocate a new 32KB block from legacy heap.
        my ptr $legacy_ptr = $heap_base;
        my ptr $legacy_cursor = Brocken::load_i64($legacy_ptr);
        my i64 $cursor_off = Brocken::ptr_sub($legacy_cursor, $heap_base);
        my i64 $aligned_off = Brocken::band(Brocken::i64_add($cursor_off, 32767), Brocken::i64_sub(0, 32768));
        my ptr $new_block = Brocken::ptr_add($heap_base, $aligned_off);
        # Zero block metadata
        Brocken::store_i64($new_block, 0);
        Brocken::store_i64(Brocken::ptr_add($new_block, 8), 0);
        Brocken::store_i64(Brocken::ptr_add($new_block, 32752), 0);
        Brocken::store_i64(Brocken::ptr_add($new_block, 32760), 1);
        # Mark Line 0 in the new block's bitmap
        Brocken::Runtime::mark_line($new_block, 0);
        # Advance legacy cursor past this block
        Brocken::store_i64($legacy_ptr, Brocken::ptr_add($new_block, 32768));
        # Make new block the current block
        Brocken::store_i64($block_base_ptr, $new_block);
        # Set immix cursor to line 0 data and limit to line 0 end
        my ptr $nb_line0 = Brocken::ptr_add($new_block, 16);
        Brocken::store_i64($cursor_ptr, $nb_line0);
        Brocken::store_i64(Brocken::ptr_add($heap_base, 32), Brocken::ptr_add($new_block, 256));
        # Increment live_count for this allocation
        Brocken::store_i64(Brocken::ptr_add($new_block, 32752), 1);
        return $nb_line0;
    }

    # Allocation fits in current line: bump cursor
    Brocken::store_i64($cursor_ptr, $new_cursor);
    # Increment live_count for this block
    my ptr $block_base_ptr2 = Brocken::ptr_add($heap_base, 56);
    my ptr $block_base2 = Brocken::load_i64($block_base_ptr2);
    my i64 $lc2 = Brocken::load_i64(Brocken::ptr_add($block_base2, 32752));
    Brocken::store_i64(Brocken::ptr_add($block_base2, 32752), Brocken::i64_add($lc2, 1));
    return $cursor;
}

# Increment the reference count of a fat scalar at $obj.
# The refcount is a u16 at offset 0 of the 8-byte header.
sub Brocken::Runtime::incref(ptr $obj) {
    if (Brocken::ptr_cmp_eq($obj, 0)) {
        return;
    }
    my i64 $header = Brocken::load_i64($obj);
    my i64 $old_rc = Brocken::band($header, 65535);
    my i64 $new_rc = Brocken::i64_add($old_rc, 1);
    if (Brocken::ptr_cmp_gt($new_rc, 65535)) {
        $new_rc = 65535;
    }
    Brocken::store_i64($obj, Brocken::i64_add(Brocken::i64_sub($header, $old_rc), $new_rc));
    return;
}

# Decrement the reference count of a fat scalar at $obj.
# When RC reaches 0, pushes the object onto the segregated free list
# at heap_base+48 for immediate reuse (hot path) AND decrements the
# containing block's live_count. If live_count reaches 0, the entire
# block is recycled to free_blocks.
sub Brocken::Runtime::decref(ptr $obj, ptr $heap_base) {
    if (Brocken::ptr_cmp_eq($obj, 0)) {
        return;
    }
    my i64 $header = Brocken::load_i64($obj);
    my i64 $old_rc = Brocken::band($header, 65535);
    my i64 $new_rc = Brocken::i64_sub($old_rc, 1);
    Brocken::store_i64($obj, Brocken::i64_add(Brocken::i64_sub($header, $old_rc), $new_rc));
    if (Brocken::ptr_cmp_eq($new_rc, 0) && Brocken::ptr_cmp_eq($heap_base, 0) == 0) {
        # Push to free16 list for immediate reuse
        my ptr $free16_ptr = Brocken::ptr_add($heap_base, 48);
        my ptr $head = Brocken::load_i64($free16_ptr);
        Brocken::store_i64(Brocken::ptr_add($obj, 8), $head);
        Brocken::store_i64($free16_ptr, $obj);
        # Decrement live_count for the containing block.
        # Read current_block from ICB offset 56 (set by _init or bump_alloc).
        my ptr $block_base_ptr = Brocken::ptr_add($heap_base, 56);
        my ptr $block_base = Brocken::load_i64($block_base_ptr);
        my ptr $lc_ptr = Brocken::ptr_add($block_base, 32752);
        my i64 $lc = Brocken::load_i64($lc_ptr);
        $lc = Brocken::i64_sub($lc, 1);
        Brocken::store_i64($lc_ptr, $lc);
        if (Brocken::ptr_cmp_eq($lc, 0)) {
            # Block fully empty — recycle to free_blocks
            my ptr $fb_ptr = Brocken::ptr_add($heap_base, 40);
            my ptr $fb_head = Brocken::load_i64($fb_ptr);
            # Use [block+0] as next pointer in the free_blocks list
            Brocken::store_i64($block_base, $fb_head);
            Brocken::store_i64($fb_ptr, $block_base);
        }
    }
    return;
}

# Context helpers for want() (bitmask: bit0=scalar, bit1=list, bit2=void)
sub Brocken::Runtime::want_is_scalar(i64 $__want) -> i64 {
    return Brocken::band($__want, 1);
}
sub Brocken::Runtime::want_is_list(i64 $__want) -> i64 {
    return Brocken::band($__want, 2);
}
sub Brocken::Runtime::want_is_void(i64 $__want) -> i64 {
    return Brocken::band($__want, 4);
}


# Return the current legacy bump pointer at ICB offset 0.
sub Brocken::Runtime::heap_cursor(ptr $heap_base) -> ptr {
    return Brocken::load_i64($heap_base);
}

# Return the current Immix bump pointer at ICB offset 24.
sub Brocken::Runtime::immix_cursor(ptr $heap_base) -> ptr {
    return Brocken::load_i64(Brocken::ptr_add($heap_base, 24));
}

# Return the current Immix line limit at ICB offset 32.
sub Brocken::Runtime::immix_limit(ptr $heap_base) -> ptr {
    return Brocken::load_i64(Brocken::ptr_add($heap_base, 32));
}

# Return how many bytes remain in the current line (limit - cursor).
sub Brocken::Runtime::line_remaining(ptr $heap_base) -> i64 {
    my ptr $cursor = Brocken::load_i64(Brocken::ptr_add($heap_base, 24));
    my ptr $limit = Brocken::load_i64(Brocken::ptr_add($heap_base, 32));
    return Brocken::ptr_sub($limit, $cursor);
}

# Return how many bytes remain in the current Immix block (block_base + 32752 - cursor).
# 32752 = 32768 - 16 (the last 16 bytes are block metadata: live_count + reserved).
sub Brocken::Runtime::block_remaining(ptr $heap_base) -> i64 {
    my ptr $block_base = Brocken::load_i64(Brocken::ptr_add($heap_base, 56));
    my ptr $cursor = Brocken::load_i64(Brocken::ptr_add($heap_base, 24));
    my ptr $block_end = Brocken::ptr_add($block_base, 32752);
    return Brocken::ptr_sub($block_end, $cursor);
}

# Return the number of objects on the free16 segregated free list at ICB offset 48.
sub Brocken::Runtime::free16_count(ptr $heap_base) -> i64 {
    my ptr $p = Brocken::load_i64(Brocken::ptr_add($heap_base, 48));
    my i64 $count = 0;
    while (Brocken::ptr_cmp_eq($p, 0) == 0) {
        $count = Brocken::i64_add($count, 1);
        $p = Brocken::load_i64(Brocken::ptr_add($p, 8));
    }
    return $count;
}

# Return the number of free 32KB blocks on the free_blocks list at ICB offset 40.
sub Brocken::Runtime::free_blocks_count(ptr $heap_base) -> i64 {
    my ptr $p = Brocken::load_i64(Brocken::ptr_add($heap_base, 40));
    my i64 $count = 0;
    while (Brocken::ptr_cmp_eq($p, 0) == 0) {
        $count = Brocken::i64_add($count, 1);
        $p = Brocken::load_i64($p);
    }
    return $count;
}


# Return a packed bitmask of heap status:
#   bit 0: line full (immix_cursor >= immix_limit)
#   bit 1: block full (cursor >= block_end)
#   bit 2: free16_head nonempty
#   bit 3: free_blocks list nonempty
#   bits 4+: reserved (0)
sub Brocken::Runtime::mem_status(ptr $heap_base) -> i64 {
    my i64 $result = 0;
    my ptr $cursor = Brocken::load_i64(Brocken::ptr_add($heap_base, 24));
    my ptr $limit  = Brocken::load_i64(Brocken::ptr_add($heap_base, 32));
    if (Brocken::ptr_cmp_ge($cursor, $limit)) {
        $result = Brocken::bor($result, 1);
    }
    my ptr $block_base = Brocken::load_i64(Brocken::ptr_add($heap_base, 56));
    my ptr $block_end  = Brocken::ptr_add($block_base, 32752);
    if (Brocken::ptr_cmp_ge($cursor, $block_end)) {
        $result = Brocken::bor($result, 2);
    }
    my ptr $free16 = Brocken::load_i64(Brocken::ptr_add($heap_base, 48));
    if (Brocken::ptr_cmp_eq($free16, 0) == 0) {
        $result = Brocken::bor($result, 4);
    }
    my ptr $free_blocks = Brocken::load_i64(Brocken::ptr_add($heap_base, 40));
    if (Brocken::ptr_cmp_eq($free_blocks, 0) == 0) {
        $result = Brocken::bor($result, 8);
    }
    return $result;
}

# Return wasted bytes in the current Immix block (sum of unused space at end of
# each line). For the current bump-only allocator this equals line_remaining;
# will track fragmentation once mark-sweep line reclamation is added.
sub Brocken::Runtime::line_waste(ptr $heap_base) -> i64 {
    my ptr $cursor = Brocken::load_i64(Brocken::ptr_add($heap_base, 24));
    my ptr $limit  = Brocken::load_i64(Brocken::ptr_add($heap_base, 32));
    return Brocken::ptr_sub($limit, $cursor);
}

# ===== Group D — Immix bitmap operations =====
# The block bitmap is 128 bits stored as two i64 words:
#   [block + 0]: bits 0-63 (lines 0-63)
#   [block + 8]: bits 64-127 (lines 64-127)
# Bit N = 1 means line N has been used (allocated from).

# Mark line N in the block's 128-bit line bitmap.
sub Brocken::Runtime::mark_line(ptr $block, i64 $line_idx) {
    if (Brocken::ptr_cmp_gt(64, $line_idx)) {
        my i64 $old = Brocken::load_i64($block);
        my i64 $mask = Brocken::shl(1, $line_idx);
        Brocken::store_i64($block, Brocken::bor($old, $mask));
    } else {
        my i64 $bit = Brocken::i64_sub($line_idx, 64);
        my i64 $old = Brocken::load_i64(Brocken::ptr_add($block, 8));
        my i64 $mask = Brocken::shl(1, $bit);
        Brocken::store_i64(Brocken::ptr_add($block, 8), Brocken::bor($old, $mask));
    }
    return;
}

# Count how many lines are marked (in use) in the block's bitmap.
# Returns the number of lines with bit = 1.
sub Brocken::Runtime::sweep_block(ptr $block) -> i64 {
    my i64 $count = 0;
    my i64 $word0 = Brocken::load_i64($block);
    my i64 $word1 = Brocken::load_i64(Brocken::ptr_add($block, 8));
    # Count bits in word0 (lines 0-63)
    my i64 $i = 0;
    while (Brocken::ptr_cmp_gt(64, $i)) {
        my i64 $mask = Brocken::shl(1, $i);
        if (Brocken::ptr_cmp_eq(Brocken::band($word0, $mask), 0) == 0) {
            $count = Brocken::i64_add($count, 1);
        }
        $i = Brocken::i64_add($i, 1);
    }
    # Count bits in word1 (lines 64-127)
    $i = 0;
    while (Brocken::ptr_cmp_gt(64, $i)) {
        my i64 $mask = Brocken::shl(1, $i);
        if (Brocken::ptr_cmp_eq(Brocken::band($word1, $mask), 0) == 0) {
            $count = Brocken::i64_add($count, 1);
        }
        $i = Brocken::i64_add($i, 1);
    }
    return $count;
}

# Push an empty block onto the free_blocks list at ICB offset 40.
# Clears the bitmap and resets next_free before pushing.
sub Brocken::Runtime::recycle_block(ptr $heap_base, ptr $block) {
    Brocken::Runtime::clear_block_bitmap($block);
    Brocken::store_i64(Brocken::ptr_add($block, 32760), 0);
    my ptr $fb_ptr = Brocken::ptr_add($heap_base, 40);
    my ptr $fb_head = Brocken::load_i64($fb_ptr);
    Brocken::store_i64($block, $fb_head);
    Brocken::store_i64($fb_ptr, $block);
    return;
}

# Return the live_count for the current block (read from ICB offset 56).
sub Brocken::Runtime::live_count(ptr $heap_base) -> i64 {
    my ptr $block_base = Brocken::load_i64(Brocken::ptr_add($heap_base, 56));
    return Brocken::load_i64(Brocken::ptr_add($block_base, 32752));
}

# Zero both bitmap words for a block.
sub Brocken::Runtime::clear_block_bitmap(ptr $block) {
    Brocken::store_i64($block, 0);
    Brocken::store_i64(Brocken::ptr_add($block, 8), 0);
    return;
}

# Scan bitmap starting from $start_idx, return first unmarked (free) line index.
# Returns -1 if all lines from $start_idx..127 are marked.
sub Brocken::Runtime::find_free_line(ptr $block, i64 $start_idx) -> i64 {
    my i64 $i = $start_idx;
    my i64 $word0 = Brocken::load_i64($block);
    while (Brocken::ptr_cmp_gt(64, $i)) {
        my i64 $mask = Brocken::shl(1, $i);
        if (Brocken::ptr_cmp_eq(Brocken::band($word0, $mask), 0)) {
            return $i;
        }
        $i = Brocken::i64_add($i, 1);
    }
    my i64 $bit = Brocken::i64_sub($i, 64);
    my i64 $word1 = Brocken::load_i64(Brocken::ptr_add($block, 8));
    while (Brocken::ptr_cmp_gt(64, $bit)) {
        my i64 $mask = Brocken::shl(1, $bit);
        if (Brocken::ptr_cmp_eq(Brocken::band($word1, $mask), 0)) {
            return Brocken::i64_add($bit, 64);
        }
        $bit = Brocken::i64_add($bit, 1);
    }
    return -1;
}

# Return the next_free hint for a block (line index to start scanning from).
sub Brocken::Runtime::get_next_free(ptr $block) -> i64 {
    return Brocken::load_i64(Brocken::ptr_add($block, 32760));
}

# Store the next_free hint for a block.
sub Brocken::Runtime::set_next_free(ptr $block, i64 $idx) {
    Brocken::store_i64(Brocken::ptr_add($block, 32760), $idx);
    return;
}
