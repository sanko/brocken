# core.brocken -- Brocken v0.1 Runtime Primitives
# Automatically compiled alongside user code.

# Heap metadata in the first 24 bytes of the heap buffer:
#   [heap_base +  0] = cursor (ptr to next free byte, starts at heap_base + 24)
#   [heap_base +  8] = limit (ptr past the last usable byte)
#   [heap_base + 16] = cap   (ptr past the end of the heap the host asked for)
#
# `limit` is deliberately *not* `cap` to begin with. A wasm module only
# declares linear memory up front, and the linker declares a single 64 KiB
# page, while the host asks for a 1 MiB heap. Recording the full 1 MiB as
# usable would hand out addresses in a range the module does not own yet, and
# the first write past the declared page would trap. Instead we start out
# knowing only the pages the host actually granted and grow on demand, so
# crossing the declared page asks for more memory rather than writing out of
# bounds. Native builds are handed a fixed region, `memory_size` reports 0
# there, and the heap is simply the region we were given.
sub Brocken::Runtime::_init(ptr $heap_base, i64 $heap_size) {
    my ptr $cursor_ptr = $heap_base;
    my ptr $limit_ptr  = Brocken::ptr_add($heap_base, 8);
    my ptr $cap_ptr    = Brocken::ptr_add($heap_base, 16);

    my ptr $initial_cursor = Brocken::ptr_add($heap_base, 24);
    my ptr $cap = Brocken::ptr_add($heap_base, $heap_size);
    Brocken::store_i64($cursor_ptr, $initial_cursor);
    Brocken::store_i64($cap_ptr, $cap);

    my ptr $limit = $cap;
    my i32 $pages = Brocken::memory_size();
    if ($pages > 0) {
        my i64 $backed = $pages * 65536;
        my ptr $backed_end = Brocken::ptr_add(0, $backed);
        if (Brocken::ptr_cmp_gt($cap, $backed_end)) {
            $limit = $backed_end;
        }
    }
    Brocken::store_i64($limit_ptr, $limit);
    return;
}

# Fail loudly when the allocator could not satisfy a request. `bump_alloc`
# signals exhaustion by returning 0, and handing that straight to a
# constructor made it store through a null pointer -- on wasm a wild write
# rather than the allocation failure it actually is.
sub Brocken::Runtime::check_alloc(ptr $ptr) -> ptr {
    if (Brocken::ptr_cmp_eq($ptr, 0)) {
        # Storing through the null pointer traps on every backend we generate,
        # which is the clearest signal available without plumbing a dedicated
        # abort instruction through the IR.
        my i64 $scratch = 0;
        Brocken::store_i64($ptr, $scratch);
    }
    return $ptr;
}

# Bump-allocate $size bytes from the heap at $heap_base.
# Returns pointer to the allocated block, or 0 on out-of-memory.
sub Brocken::Runtime::bump_alloc(ptr $heap_base, i64 $size) -> ptr {
    my ptr $cursor_ptr = $heap_base;
    my ptr $limit_ptr  = Brocken::ptr_add($heap_base, 8);
    my ptr $cap_ptr    = Brocken::ptr_add($heap_base, 16);

    my ptr $cursor = Brocken::load_i64($cursor_ptr);
    my ptr $limit  = Brocken::load_i64($limit_ptr);
    my ptr $cap    = Brocken::load_i64($cap_ptr);
    my ptr $result = $cursor;
    my ptr $new_cursor = Brocken::ptr_add($cursor, $size);

    if (Brocken::ptr_cmp_gt($new_cursor, $limit)) {
        # The block runs past what the host has backed, so ask for enough pages
        # to reach it, rounded up, and never past the heap the host asked for.
        # A refusal is not fatal on its own: the limit stays where it is and
        # the out-of-memory check below decides.
        my i32 $before = Brocken::memory_size();
        if ($before > 0) {
            my i64 $backed = $before * 65536;
            if (Brocken::ptr_cmp_lt($new_cursor, $cap)) {
                my i64 $want = (Brocken::ptr_sub($new_cursor, 0) - $backed + 65535) / 65536;
                my i64 $room = (Brocken::ptr_sub($cap, 0) - $backed + 65535) / 65536;
                if ($want > $room) {
                    $want = $room;
                }
                if ($want > 0) {
                    # `memory_grow` yields the previous size in pages, or -1 if
                    # the host said no, so a success tells us the new size
                    # without asking a second time.
                    my i32 $grew = Brocken::memory_grow($want);
                    if ($grew >= 0) {
                        my i64 $now = ($grew + $want) * 65536;
                        my ptr $now_end = Brocken::ptr_add(0, $now);
                        $limit = $cap;
                        if (Brocken::ptr_cmp_gt($cap, $now_end)) {
                            $limit = $now_end;
                        }
                        Brocken::store_i64($limit_ptr, $limit);
                    }
                }
            }
        }
        if (Brocken::ptr_cmp_gt($new_cursor, $limit)) {
            return 0;
        }
    }

    Brocken::store_i64($cursor_ptr, $new_cursor);
    return $result;
}
