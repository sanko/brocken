# core.brocken: Brocken v0.1.x Runtime Primitives
# Automatically compiled alongside user code.
#
# ICB (Isolate Control Block) layout: see lib/Brocken/ICB.pm for offsets.
# Accessor functions below (get_*/set_*) are the single source of truth for ICB field offsets within Brocken runtime
# code.
#
# Immix block layout (32 KB = 32768 bytes per block):
#   [block + 0..15]:     bitmap (128-bit line bitmap, bit N = line N in use)
#   [block + 16..255]:   Line 0  (240 usable bytes)
#   [block + 256..511]:  Line 1  (256 bytes)
#   ...
#   [block + 32512..32751]: Line 127 (240 usable bytes - last 16 bytes are metadata)
#   [block + 32752..32759]:  live_count (i64) - number of live allocations in block
#   [block + 32760..32767]:  next_free (i64) - next line index to start scanning for free lines
#   Total per block: 16 + 240 + 126*256 + 240 + 16 = 32768
#
# Objects freed by decref (when RC reaches 0) are pushed onto free16_head.
# The next pointer is stored at [obj + 8] (payload area of the freed object).
# bump_alloc checks free16_head first (hot path), then falls back to line-aware bump allocation within the current
# Immix block (cold path). When a block's live_count reaches 0, the entire block is recycled to free_blocks.
# ICB accessor functions
# Offsets match lib/Brocken/ICB.pm constants. If the ICB layout changes, update these functions and regenerate ICB.pm
# via Brocken::Layout.
package Brocken::Runtime;

sub get_heap_cursor( ptr $hb ) : returns(ptr) {
    return Brocken::load_i64($hb);
}

sub set_heap_cursor( ptr $hb, ptr $val ) {
    Brocken::store_i64( $hb, $val );
}

