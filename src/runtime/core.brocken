# Immix block geometry
# A block is block_size() bytes. Every block begins on a block_size grid anchored at the arena base, i.e. the first block
# immediately after the ICB. Deriving the metadata offsets and the address->block mapping from these helpers keeps the
# geometry in one place so the two cannot drift apart.
sub icb_size() : returns(i64) {
    return 160;
}

sub block_size() : returns(i64) {
    return 32768;
}

sub block_live_count_offset() : returns(i64) {
    return Brocken::i64_sub( block_size(), 16 );
}

sub block_next_free_offset() : returns(i64) {
    return Brocken::i64_sub( block_size(), 8 );
}

# Base of the block that owns the allocation at $addr. Every block is aligned to a block_size grid anchored at the arena
# base, so the owning block is the arena-aligned region that contains $addr.
sub block_of( ptr $hb, ptr $addr ) : returns(ptr) {
    my ptr $arena  = Brocken::ptr_add( $hb, icb_size() );
    my i64 $mask   = Brocken::i64_sub( 0, block_size() );
    my i64 $offset = Brocken::ptr_sub( $addr, $arena );
    return Brocken::ptr_add( $arena, Brocken::band( $offset, $mask ) );
}

# Initialize ICB and Immix heap metadata.
sub _init( ptr $heap_base, i64 $heap_size ) {

    # Block starts after the ICB (icb_size() bytes). Cannot read current_block from ICB yet, it hasn't
    # been initialized, so compute it directly.
    my ptr $block_base = Brocken::ptr_add( $heap_base,  icb_size() );
    my ptr $line0_data = Brocken::ptr_add( $block_base, 16 );

    # Zero the block metadata: bitmap at [block+0..15], live_count and next_free in the block trailer.
    Brocken::store_i64( $block_base, 0 );
    Brocken::store_i64( Brocken::ptr_add( $block_base, 8 ),                         0 );
    Brocken::store_i64( Brocken::ptr_add( $block_base, block_live_count_offset() ), 0 );
    Brocken::store_i64( Brocken::ptr_add( $block_base, block_next_free_offset() ),  0 );
    mark_line( $block_base, 0 );
    set_heap_cursor( $heap_base, $line0_data );
    set_current_fcb( $heap_base, 0 );
    set_fiber_head( $heap_base, 0 );
    set_immix_cursor( $heap_base, $line0_data );
    set_immix_limit( $heap_base, Brocken::ptr_add( $block_base, 256 ) );
    set_free_blocks( $heap_base, 0 );
    set_free16_head( $heap_base, 0 );
    set_free_big_head( $heap_base, 0 );
    set_suspect_buffer_head( $heap_base, 0 );
    set_fuel( $heap_base, 0 );
    set_err_code( $heap_base, 0 );
    set_current_block( $heap_base, $block_base );
    set_memory_limit( $heap_base, 0 );
    set_memory_used( $heap_base, 0 );
    set_capabilities( $heap_base, 0 );
    set_gate_table( $heap_base, 0 );
    set_host_icb( $heap_base, 0 );
    set_exception_handler_stack( $heap_base, 0 );
    set_thrown_value( $heap_base, 0 );

    # stack_limit is deliberately untouched: the native entry prologue seeds it from the actual frame pointer before
    # _init runs, and _init has no way to know the main thread's stack budget here.
    return;
}

# Allocate $size bytes from the Immix-managed heap at $heap_base.
# Hot path: check segregated free list (free16_head).
# Cold path: line-aware bump allocation within current Immix block.
sub bump_alloc( ptr $heap_base, i64 $size ) : returns(ptr) {

    # Memory limit check
    my i64 $mem_limit = get_memory_limit($heap_base);
    if ( Brocken::ptr_cmp_gt( $mem_limit, 0 ) ) {
        my i64 $mem_used = get_memory_used($heap_base);
        my i64 $new_used = Brocken::i64_add( $mem_used, $size );
        if ( Brocken::ptr_cmp_gt( $new_used, $mem_limit ) ) {
            set_err_code( $heap_base, 1 );
            return 0;
        }
    }

    # Hot path: free16_head. A free16 slot is exactly 16 usable bytes, so it only satisfies requests that fit in one;
    # anything larger must not be handed a 16-byte slot or the tail of the object would overwrite the next free slot.
    my ptr $head   = get_free16_head($heap_base);
    my i64 $fits16 = Brocken::ptr_cmp_ge( 16, $size );
    if ( Brocken::ptr_cmp_eq( $head, 0 ) == 0 && Brocken::ptr_cmp_eq( $fits16, 0 ) == 0 ) {
        my ptr $next = Brocken::load_i64( Brocken::ptr_add( $head, 8 ) );
        set_free16_head( $heap_base, $next );
        return $head;
    }

    # Immix line-aware bump: load immix_cursor and immix_limit
    my ptr $cursor     = get_immix_cursor($heap_base);
    my ptr $limit      = get_immix_limit($heap_base);
    my ptr $new_cursor = Brocken::ptr_add( $cursor, $size );

    # Does the allocation fit within the current line?
    if ( Brocken::ptr_cmp_gt( $new_cursor, $limit ) ) {

        # Current line exhausted. Find next free line via bitmap.
        my ptr $block_base      = get_current_block($heap_base);
        my i64 $offset_in_block = Brocken::ptr_sub( $cursor, $block_base );
        my i64 $cur_line_idx    = Brocken::shr( $offset_in_block, 8 );
        my i64 $next_scan       = $cur_line_idx;
        my i64 $nf              = Brocken::load_i64( Brocken::ptr_add( $block_base, block_next_free_offset() ) );
        if ( Brocken::ptr_cmp_gt( $nf, $next_scan ) ) {
            $next_scan = $nf;
        }
        my i64 $found = find_free_line( $block_base, $next_scan );
        if ( Brocken::ptr_cmp_eq( $found, -1 ) == 0 ) {
            my i64 $line_byte_off = Brocken::shl( $found, 8 );
            my ptr $line_start    = Brocken::ptr_add( $block_base, $line_byte_off );
            my ptr $after_alloc   = Brocken::ptr_add( $line_start, $size );
            my ptr $block_end     = Brocken::ptr_add( $block_base, block_live_count_offset() );
            if ( Brocken::ptr_cmp_gt( $after_alloc, $block_end ) == 0 ) {
                set_immix_cursor( $heap_base, $after_alloc );
                my ptr $new_limit = Brocken::ptr_add( $line_start, 256 );
                if ( Brocken::ptr_cmp_gt( $new_limit, $block_end ) ) {
                    $new_limit = $block_end;
                }
                set_immix_limit( $heap_base, $new_limit );
                mark_span( $block_base, Brocken::shl( $found, 8 ), $size );
                my i64 $next_nf = Brocken::i64_add( $found, 1 );
                Brocken::store_i64( Brocken::ptr_add( $block_base, block_next_free_offset() ), $next_nf );
                my i64 $lc = Brocken::load_i64( Brocken::ptr_add( $block_base, block_live_count_offset() ) );
                Brocken::store_i64( Brocken::ptr_add( $block_base, block_live_count_offset() ), Brocken::i64_add( $lc, 1 ) );
                my i64 $mu1 = get_memory_used($heap_base);
                set_memory_used( $heap_base, Brocken::i64_add( $mu1, $size ) );
                return $line_start;
            }
        }

        # No free line found in current block. Try free_blocks.
        my ptr $fb = get_free_blocks($heap_base);
        if ( Brocken::ptr_cmp_eq( $fb, 0 ) == 0 ) {
            my ptr $fb_next = Brocken::load_i64($fb);
            set_free_blocks( $heap_base, $fb_next );
            clear_block_bitmap($fb);
            my ptr $fb_line0 = Brocken::ptr_add( $fb, 16 );
            set_immix_cursor( $heap_base, $fb_line0 );
            set_immix_limit( $heap_base, Brocken::ptr_add( $fb, 256 ) );
            Brocken::store_i64( Brocken::ptr_add( $fb, block_live_count_offset() ), 1 );
            Brocken::store_i64( Brocken::ptr_add( $fb, block_next_free_offset() ),  1 );
            mark_span( $fb, 16, $size );
            set_current_block( $heap_base, $fb );
            set_immix_cursor( $heap_base, Brocken::ptr_add( $fb_line0, $size ) );
            my i64 $mu2 = get_memory_used($heap_base);
            set_memory_used( $heap_base, Brocken::i64_add( $mu2, $size ) );
            return $fb_line0;
        }

        # No free block available. Carve a fresh block from the legacy heap. Blocks sit on a block_size() grid anchored at
        # the arena base (the first block, right after the ICB), not at $heap_base: anchoring on $heap_base would place
        # block N+1 160 bytes inside block N's trailer and corrupt its live_count/next_free.
        my ptr $arena_base    = Brocken::ptr_add( $heap_base, icb_size() );
        my ptr $legacy_cursor = get_heap_cursor($heap_base);
        my i64 $cursor_off    = Brocken::ptr_sub( $legacy_cursor, $arena_base );
        my i64 $aligned_off
            = Brocken::band( Brocken::i64_add( $cursor_off, Brocken::i64_sub( block_size(), 1 ) ), Brocken::i64_sub( 0, block_size() ) );
        my ptr $new_block = Brocken::ptr_add( $arena_base, $aligned_off );
        Brocken::store_i64( $new_block, 0 );
        Brocken::store_i64( Brocken::ptr_add( $new_block, 8 ),                         0 );
        Brocken::store_i64( Brocken::ptr_add( $new_block, block_live_count_offset() ), 0 );
        Brocken::store_i64( Brocken::ptr_add( $new_block, block_next_free_offset() ),  1 );
        mark_span( $new_block, 16, $size );
        set_heap_cursor( $heap_base, Brocken::ptr_add( $new_block, block_size() ) );
        set_current_block( $heap_base, $new_block );
        my ptr $nb_line0 = Brocken::ptr_add( $new_block, 16 );
        set_immix_cursor( $heap_base, $nb_line0 );
        set_immix_limit( $heap_base, Brocken::ptr_add( $new_block, 256 ) );
        Brocken::store_i64( Brocken::ptr_add( $new_block, block_live_count_offset() ), 1 );
        my i64 $mu3 = get_memory_used($heap_base);
        set_memory_used( $heap_base, Brocken::i64_add( $mu3, $size ) );
        return $nb_line0;
    }

    # Allocation fits in current line: bump cursor
    set_immix_cursor( $heap_base, $new_cursor );
    my ptr $block_base2 = get_current_block($heap_base);
    my i64 $lc2         = Brocken::load_i64( Brocken::ptr_add( $block_base2, block_live_count_offset() ) );
    Brocken::store_i64( Brocken::ptr_add( $block_base2, block_live_count_offset() ), Brocken::i64_add( $lc2, 1 ) );
    my i64 $mu4 = get_memory_used($heap_base);
    set_memory_used( $heap_base, Brocken::i64_add( $mu4, $size ) );
    return $cursor;
}

# Increment the reference count of a fat scalar at $obj.
sub incref( ptr $obj ) {
    if ( Brocken::ptr_cmp_eq( $obj, 0 ) ) {
        return;
    }
    my i64 $header = Brocken::load_i64($obj);
    my i64 $old_rc = Brocken::band( $header, 65535 );
    my i64 $new_rc = Brocken::i64_add( $old_rc, 1 );
    if ( Brocken::ptr_cmp_gt( $new_rc, 65535 ) ) {
        $new_rc = 65535;
    }
    Brocken::store_i64( $obj, Brocken::i64_add( Brocken::i64_sub( $header, $old_rc ), $new_rc ) );
    return;
}

# Decrement the reference count of a fat scalar at $obj.
# When RC reaches 0, pushes the object onto the segregated free list for immediate reuse (hot path) AND decrements the
# owning block's live_count. If live_count reaches 0, the entire block is recycled to free_blocks.
sub decref( ptr $obj, ptr $heap_base ) {
    if ( Brocken::ptr_cmp_eq( $obj, 0 ) ) {
        return;
    }
    my i64 $header = Brocken::load_i64($obj);
    my i64 $old_rc = Brocken::band( $header, 65535 );
    my i64 $new_rc = Brocken::i64_sub( $old_rc, 1 );
    Brocken::store_i64( $obj, Brocken::i64_add( Brocken::i64_sub( $header, $old_rc ), $new_rc ) );
    if ( Brocken::ptr_cmp_eq( $new_rc, 0 ) && Brocken::ptr_cmp_eq( $heap_base, 0 ) == 0 ) {

        # Tag 9 arrays and tag 8 hashes are recycled through the segregated free_big list: the bytes field at [obj+16]
        # survives the free (only [obj+8] carries the next pointer), so alloc_array/hash_alloc can size-match a future
        # request to it. Block live_count recycling is skipped: big-object reuse is slab-granular, not block-granular.
        # A hash's stored values are released by hash_release before it is decref'd, never from here, so that a grow
        # (which moves the values into the new table) can drop the old table without touching them.
        my i64 $tag = Brocken::shr( $header, 24 );
        if ( Brocken::ptr_cmp_eq( $tag, 9 ) || Brocken::ptr_cmp_eq( $tag, 8 ) ) {
            my ptr $big_head = get_free_big_head($heap_base);
            Brocken::store_i64( Brocken::ptr_add( $obj, 8 ), $big_head );
            set_free_big_head( $heap_base, $obj );
        }
        else {
            # Push to free16 list for immediate reuse
            my ptr $head = get_free16_head($heap_base);
            Brocken::store_i64( Brocken::ptr_add( $obj, 8 ), $head );
            set_free16_head( $heap_base, $obj );

            # Decrement live_count for the block that actually owns this object. It may have been allocated in an earlier
            # block than the current allocation block, so derive the owner from the address.
            my ptr $block_base = block_of( $heap_base, $obj );
            my ptr $lc_ptr     = Brocken::ptr_add( $block_base, block_live_count_offset() );
            my i64 $lc         = Brocken::load_i64($lc_ptr);
            $lc = Brocken::i64_sub( $lc, 1 );
            Brocken::store_i64( $lc_ptr, $lc );
            if ( Brocken::ptr_cmp_eq( $lc, 0 ) ) {

                # Block fully empty - recycle to free_blocks
                my ptr $fb_head = get_free_blocks($heap_base);
                Brocken::store_i64( $block_base, $fb_head );
                set_free_blocks( $heap_base, $block_base );
            }
        }
    }
    elsif ( Brocken::ptr_cmp_gt( $new_rc, 0 ) && Brocken::ptr_cmp_eq( $heap_base, 0 ) == 0 ) {

        # R3: RC > 0 after decrement - suspect for cycle detection.
        my i64 $flags = get_gc_flags($obj);
        if ( Brocken::ptr_cmp_eq( Brocken::band( $flags, 4 ), 0 ) && Brocken::ptr_cmp_eq( Brocken::band( $flags, 2 ), 0 ) ) {
            push_suspect_buffer( $obj, $heap_base );
        }
    }
    return;
}

# Decrement the reference count of a class instance without reclaiming it. Returns the new count so the compiled
# release site can run the statically-known destructor (and then reclaim through free_obj) exactly when it reaches
# zero. Splitting the decrement from the reclaim is what keeps the runtime dispatch-free: the destructor is selected
# at the call site, where the instance's static class is known, instead of through an indirect call the runtime cannot
# make. The suspect-buffer bookkeeping matches decref (R3) for counts that stay live.
sub decref_obj( ptr $obj, ptr $heap_base ) : returns(i64) {
    if ( Brocken::ptr_cmp_eq( $obj, 0 ) ) {
        return 0;
    }
    my i64 $header = Brocken::load_i64($obj);
    my i64 $old_rc = Brocken::band( $header, 65535 );
    my i64 $new_rc = Brocken::i64_sub( $old_rc, 1 );
    Brocken::store_i64( $obj, Brocken::i64_add( Brocken::i64_sub( $header, $old_rc ), $new_rc ) );
    if ( Brocken::ptr_cmp_gt( $new_rc, 0 ) && Brocken::ptr_cmp_eq( $heap_base, 0 ) == 0 ) {
        my i64 $flags = get_gc_flags($obj);
        if ( Brocken::ptr_cmp_eq( Brocken::band( $flags, 4 ), 0 ) && Brocken::ptr_cmp_eq( Brocken::band( $flags, 2 ), 0 ) ) {
            push_suspect_buffer( $obj, $heap_base );
        }
    }
    return $new_rc;
}

# Reclaim a class instance whose reference count already reached zero (see decref_obj). Mirrors the free16 half of
# decref -- push onto the segregated free list and decrement the owning block's live_count -- without touching the
# header, which decref_obj already updated. Class instances always land on the 16-byte free list, so the tag-9 array
# path of decref does not apply.
sub free_obj( ptr $obj, ptr $heap_base ) {
    if ( Brocken::ptr_cmp_eq( $obj, 0 ) ) {
        return;
    }
    if ( Brocken::ptr_cmp_eq( $heap_base, 0 ) ) {
        return;
    }
    my ptr $head = get_free16_head($heap_base);
    Brocken::store_i64( Brocken::ptr_add( $obj, 8 ), $head );
    set_free16_head( $heap_base, $obj );
    my ptr $block_base = block_of( $heap_base, $obj );
    my ptr $lc_ptr     = Brocken::ptr_add( $block_base, block_live_count_offset() );
    my i64 $lc         = Brocken::load_i64($lc_ptr);
    $lc = Brocken::i64_sub( $lc, 1 );
    Brocken::store_i64( $lc_ptr, $lc );
    if ( Brocken::ptr_cmp_eq( $lc, 0 ) ) {
        my ptr $fb_head = get_free_blocks($heap_base);
        Brocken::store_i64( $block_base, $fb_head );
        set_free_blocks( $heap_base, $block_base );
    }
    return;
}

# Context helpers for want() (bitmask: bit0=scalar, bit1=list, bit2=void)
sub want_is_scalar( i64 $__want ) : returns(i64) {
    return Brocken::band( $__want, 1 );
}

sub want_is_list( i64 $__want ) : returns(i64) {
    return Brocken::band( $__want, 2 );
}

sub want_is_void( i64 $__want ) : returns(i64) {
    return Brocken::band( $__want, 4 );
}

#  Heap introspection (Group A - read-only)
sub heap_cursor( ptr $heap_base ) : returns(ptr) {
    return get_heap_cursor($heap_base);
}

sub immix_cursor( ptr $heap_base ) : returns(ptr) {
    return get_immix_cursor($heap_base);
}

sub immix_limit( ptr $heap_base ) : returns(ptr) {
    return get_immix_limit($heap_base);
}

sub line_remaining( ptr $heap_base ) : returns(i64) {
    my ptr $cursor = get_immix_cursor($heap_base);
    my ptr $limit  = get_immix_limit($heap_base);
    return Brocken::ptr_sub( $limit, $cursor );
}

sub block_remaining( ptr $heap_base ) : returns(i64) {
    my ptr $block_base = get_current_block($heap_base);
    my ptr $cursor     = get_immix_cursor($heap_base);
    my ptr $block_end  = Brocken::ptr_add( $block_base, block_live_count_offset() );
    return Brocken::ptr_sub( $block_end, $cursor );
}

sub free16_count( ptr $heap_base ) : returns(i64) {
    my ptr $p     = get_free16_head($heap_base);
    my i64 $count = 0;
    while ( Brocken::ptr_cmp_eq( $p, 0 ) == 0 ) {
        $count = Brocken::i64_add( $count, 1 );
        $p     = Brocken::load_i64( Brocken::ptr_add( $p, 8 ) );
    }
    return $count;
}

sub free_blocks_count( ptr $heap_base ) : returns(i64) {
    my ptr $p     = get_free_blocks($heap_base);
    my i64 $count = 0;
    while ( Brocken::ptr_cmp_eq( $p, 0 ) == 0 ) {
        $count = Brocken::i64_add( $count, 1 );
        $p     = Brocken::load_i64($p);
    }
    return $count;
}

#  Group C - High-level helpers
sub mem_status( ptr $heap_base ) : returns(i64) {
    my i64 $result = 0;
    my ptr $cursor = get_immix_cursor($heap_base);
    my ptr $limit  = get_immix_limit($heap_base);
    if ( Brocken::ptr_cmp_ge( $cursor, $limit ) ) {
        $result = Brocken::bor( $result, 1 );
    }
    my ptr $block_base = get_current_block($heap_base);
    my ptr $block_end  = Brocken::ptr_add( $block_base, block_live_count_offset() );
    if ( Brocken::ptr_cmp_ge( $cursor, $block_end ) ) {
        $result = Brocken::bor( $result, 2 );
    }
    my ptr $free16 = get_free16_head($heap_base);
    if ( Brocken::ptr_cmp_eq( $free16, 0 ) == 0 ) {
        $result = Brocken::bor( $result, 4 );
    }
    my ptr $free_blocks = get_free_blocks($heap_base);
    if ( Brocken::ptr_cmp_eq( $free_blocks, 0 ) == 0 ) {
        $result = Brocken::bor( $result, 8 );
    }
    return $result;
}

sub line_waste( ptr $heap_base ) : returns(i64) {
    my ptr $cursor = get_immix_cursor($heap_base);
    my ptr $limit  = get_immix_limit($heap_base);
    return Brocken::ptr_sub( $limit, $cursor );
}

#  Group D - Immix bitmap operations
sub mark_line( ptr $block, i64 $line_idx ) {
    if ( Brocken::ptr_cmp_gt( 64, $line_idx ) ) {
        my i64 $old  = Brocken::load_i64($block);
        my i64 $mask = Brocken::shl( 1, $line_idx );
        Brocken::store_i64( $block, Brocken::bor( $old, $mask ) );
    }
    else {
        my i64 $bit  = Brocken::i64_sub( $line_idx, 64 );
        my i64 $old  = Brocken::load_i64( Brocken::ptr_add( $block, 8 ) );
        my i64 $mask = Brocken::shl( 1, $bit );
        Brocken::store_i64( Brocken::ptr_add( $block, 8 ), Brocken::bor( $old, $mask ) );
    }
    return;
}

# Mark every line the byte span [start_off, start_off + size) covers. A block's line 0 data begins at offset 16 (the
# 16-byte bitmap word pair occupies [0,16)), so a fresh-block allocation passes 16 and a bitmap-found one passes
# start_idx*256. Objects larger than one 256-byte line must mark every line they cross: otherwise the bitmap still
# reports the trailing lines as free and a later find_free_line hands them out again, overlapping the object.
sub mark_span( ptr $block, i64 $start_off, i64 $size ) {
    my i64 $last_byte = Brocken::i64_sub( Brocken::i64_add( $start_off, $size ), 1 );
    my i64 $li        = Brocken::shr( $start_off, 8 );
    my i64 $last      = Brocken::shr( $last_byte, 8 );
    while ( Brocken::ptr_cmp_ge( $last, $li ) ) {
        if ( Brocken::ptr_cmp_gt( 128, $li ) == 0 ) { last; }
        mark_line( $block, $li );
        $li = Brocken::i64_add( $li, 1 );
    }
    return;
}

sub sweep_block( ptr $block ) : returns(i64) {
    my i64 $count = 0;
    my i64 $word0 = Brocken::load_i64($block);
    my i64 $word1 = Brocken::load_i64( Brocken::ptr_add( $block, 8 ) );
    my i64 $i     = 0;
    while ( Brocken::ptr_cmp_gt( 64, $i ) ) {
        my i64 $mask = Brocken::shl( 1, $i );
        if ( Brocken::ptr_cmp_eq( Brocken::band( $word0, $mask ), 0 ) == 0 ) {
            $count = Brocken::i64_add( $count, 1 );
        }
        $i = Brocken::i64_add( $i, 1 );
    }
    $i = 0;
    while ( Brocken::ptr_cmp_gt( 64, $i ) ) {
        my i64 $mask = Brocken::shl( 1, $i );
        if ( Brocken::ptr_cmp_eq( Brocken::band( $word1, $mask ), 0 ) == 0 ) {
            $count = Brocken::i64_add( $count, 1 );
        }
        $i = Brocken::i64_add( $i, 1 );
    }
    return $count;
}

sub recycle_block( ptr $heap_base, ptr $block ) {
    clear_block_bitmap($block);
    Brocken::store_i64( Brocken::ptr_add( $block, block_next_free_offset() ), 0 );
    my ptr $fb_head = get_free_blocks($heap_base);
    Brocken::store_i64( $block, $fb_head );
    set_free_blocks( $heap_base, $block );
    return;
}

sub live_count( ptr $heap_base ) : returns(i64) {
    my ptr $block_base = get_current_block($heap_base);
    return Brocken::load_i64( Brocken::ptr_add( $block_base, block_live_count_offset() ) );
}

sub clear_block_bitmap( ptr $block ) {
    Brocken::store_i64( $block,                        0 );
    Brocken::store_i64( Brocken::ptr_add( $block, 8 ), 0 );
    return;
}

sub find_free_line( ptr $block, i64 $start_idx ) : returns(i64) {
    my i64 $i     = $start_idx;
    my i64 $word0 = Brocken::load_i64($block);
    while ( Brocken::ptr_cmp_gt( 64, $i ) ) {
        my i64 $mask = Brocken::shl( 1, $i );
        if ( Brocken::ptr_cmp_eq( Brocken::band( $word0, $mask ), 0 ) ) {
            return $i;
        }
        $i = Brocken::i64_add( $i, 1 );
    }
    my i64 $bit   = Brocken::i64_sub( $i, 64 );
    my i64 $word1 = Brocken::load_i64( Brocken::ptr_add( $block, 8 ) );
    while ( Brocken::ptr_cmp_gt( 64, $bit ) ) {
        my i64 $mask = Brocken::shl( 1, $bit );
        if ( Brocken::ptr_cmp_eq( Brocken::band( $word1, $mask ), 0 ) ) {
            return Brocken::i64_add( $bit, 64 );
        }
        $bit = Brocken::i64_add( $bit, 1 );
    }
    return -1;
}

sub get_next_free( ptr $block ) : returns(i64) {
    return Brocken::load_i64( Brocken::ptr_add( $block, block_next_free_offset() ) );
}

sub set_next_free( ptr $block, i64 $idx ) {
    Brocken::store_i64( Brocken::ptr_add( $block, block_next_free_offset() ), $idx );
    return;
}

# R3: Bacon/Rajan Trial Deletion (Cycle Detection)
sub get_gc_flags( ptr $obj ) : returns(i64) {
    my i64 $header = Brocken::load_i64($obj);
    return Brocken::band( Brocken::shr( $header, 16 ), 255 );
}

sub set_gc_flags( ptr $obj, i64 $flags ) {
    my i64 $header    = Brocken::load_i64($obj);
    my i64 $rc_part   = Brocken::band( $header, 65535 );
    my i64 $high_part = Brocken::shl( Brocken::shr( $header, 24 ), 24 );
    Brocken::store_i64( $obj, Brocken::bor( Brocken::bor( $rc_part, Brocken::shl( $flags, 16 ) ), $high_part ) );
    return;
}

sub push_suspect_buffer( ptr $obj, ptr $hb ) {
    my i64 $flags = get_gc_flags($obj);
    if ( Brocken::band( $flags, 2 ) ) {
        return;
    }
    my ptr $node = bump_alloc( $hb, 16 );
    if ( Brocken::ptr_cmp_eq( $node, 0 ) ) {
        return;
    }
    my ptr $head = get_suspect_buffer_head($hb);
    Brocken::store_i64( $node,                        $obj );
    Brocken::store_i64( Brocken::ptr_add( $node, 8 ), $head );
    set_suspect_buffer_head( $hb, $node );
    set_gc_flags( $obj, Brocken::bor( $flags, 3 ) );
    return;
}

sub pop_suspect_buffer( ptr $hb ) : returns(ptr) {
    my ptr $node = get_suspect_buffer_head($hb);
    if ( Brocken::ptr_cmp_eq( $node, 0 ) ) {
        return 0;
    }
    my ptr $obj  = Brocken::load_i64($node);
    my ptr $next = Brocken::load_i64( Brocken::ptr_add( $node, 8 ) );
    set_suspect_buffer_head( $hb, $next );
    my i64 $flags = get_gc_flags($obj);
    set_gc_flags( $obj, Brocken::band( $flags, 253 ) );

    # Return node to free16
    my ptr $fhead = get_free16_head($hb);
    Brocken::store_i64( Brocken::ptr_add( $node, 8 ), $fhead );
    set_free16_head( $hb, $node );
    return $obj;
}

sub gc_decref( ptr $obj, ptr $hb ) {
    if ( Brocken::ptr_cmp_eq( $obj, 0 ) ) {
        return;
    }
    my i64 $header = Brocken::load_i64($obj);
    my i64 $old_rc = Brocken::band( $header, 65535 );
    my i64 $new_rc = Brocken::i64_sub( $old_rc, 1 );
    Brocken::store_i64( $obj, Brocken::i64_add( Brocken::i64_sub( $header, $old_rc ), $new_rc ) );
    if ( Brocken::ptr_cmp_eq( $new_rc, 0 ) && Brocken::ptr_cmp_eq( $hb, 0 ) == 0 ) {
        my ptr $head = get_free16_head($hb);
        Brocken::store_i64( Brocken::ptr_add( $obj, 8 ), $head );
        set_free16_head( $hb, $obj );
        my ptr $block_base = block_of( $hb, $obj );
        my ptr $lc_ptr     = Brocken::ptr_add( $block_base, block_live_count_offset() );
        my i64 $lc         = Brocken::load_i64($lc_ptr);
        $lc = Brocken::i64_sub( $lc, 1 );
        Brocken::store_i64( $lc_ptr, $lc );

        if ( Brocken::ptr_cmp_eq( $lc, 0 ) ) {
            my ptr $fb_head = get_free_blocks($hb);
            Brocken::store_i64( $block_base, $fb_head );
            set_free_blocks( $hb, $block_base );
        }
    }
    return;
}

sub gc_scan_list( ptr $obj, ptr $hb ) {
    my i64 $count = Brocken::load_i64( Brocken::ptr_add( $obj, 8 ) );
    my i64 $i     = 0;
    while ( Brocken::ptr_cmp_gt( $count, $i ) ) {
        my ptr $elem_addr = Brocken::ptr_add( $obj, Brocken::i64_add( 16, Brocken::shl( $i, 3 ) ) );
        my i64 $elem      = Brocken::load_i64($elem_addr);
        if ( Brocken::ptr_cmp_gt( $elem, 65536 ) && Brocken::ptr_cmp_eq( Brocken::band( $elem, 7 ), 0 ) ) {
            gc_decref( $elem, $hb );
        }
        $i = Brocken::i64_add( $i, 1 );
    }
    return;
}

sub gc_scan_hash( ptr $obj, ptr $hb ) {
    my i64 $cap = hash_capacity($obj);
    my i64 $i   = 0;
    while ( Brocken::ptr_cmp_gt( $cap, $i ) ) {

        # Bucket key 0 is empty, 1 is a tombstone; neither holds a value. A live key is a borrowed string, not owned,
        # so only the value slot at +8 is a candidate reference.
        my ptr $slot = hash_bucket( $obj, $i );
        my i64 $key  = Brocken::load_i64($slot);
        if ( Brocken::ptr_cmp_eq( $key, 0 ) == 0 && Brocken::ptr_cmp_eq( $key, 1 ) == 0 ) {
            my i64 $val = Brocken::load_i64( Brocken::ptr_add( $slot, 8 ) );
            if ( Brocken::ptr_cmp_gt( $val, 65536 ) && Brocken::ptr_cmp_eq( Brocken::band( $val, 7 ), 0 ) ) {
                gc_decref( $val, $hb );
            }
        }
        $i = Brocken::i64_add( $i, 1 );
    }
    return;
}

sub gc_scan_obj( ptr $obj, ptr $hb ) {
    my i64 $header = Brocken::load_i64($obj);
    my i64 $tag    = Brocken::band( Brocken::shr( $header, 24 ), 255 );
    if ( Brocken::ptr_cmp_eq( $tag, 7 ) ) {
        gc_scan_list( $obj, $hb );
    }
    elsif ( Brocken::ptr_cmp_eq( $tag, 8 ) ) {
        gc_scan_hash( $obj, $hb );
    }
    elsif ( Brocken::ptr_cmp_eq( $tag, 4 ) ) {

        # A class instance carries its dense class id in the auxiliary bits; a boxed `ptr` shares the tag byte but
        # leaves them zero. The generated dispatch selects the instance's own __scan by that id.
        my i64 $class_id = Brocken::shr( $header, 32 );
        if ( Brocken::ptr_cmp_gt( $class_id, 0 ) ) {
            gc_scan_class( $obj, $hb );
        }
    }
    return;
}

sub gc_restore_refs( ptr $obj ) {
    my i64 $header = Brocken::load_i64($obj);
    my i64 $tag    = Brocken::band( Brocken::shr( $header, 24 ), 255 );
    if ( Brocken::ptr_cmp_eq( $tag, 7 ) ) {
        my i64 $count = Brocken::load_i64( Brocken::ptr_add( $obj, 8 ) );
        my i64 $i     = 0;
        while ( Brocken::ptr_cmp_gt( $count, $i ) ) {
            my ptr $elem_addr = Brocken::ptr_add( $obj, Brocken::i64_add( 16, Brocken::shl( $i, 3 ) ) );
            my i64 $elem      = Brocken::load_i64($elem_addr);
            if ( Brocken::ptr_cmp_gt( $elem, 65536 ) && Brocken::ptr_cmp_eq( Brocken::band( $elem, 7 ), 0 ) ) {
                incref($elem);
            }
            $i = Brocken::i64_add( $i, 1 );
        }
    }
    elsif ( Brocken::ptr_cmp_eq( $tag, 8 ) ) {
        my i64 $cap = hash_capacity($obj);
        my i64 $i   = 0;
        while ( Brocken::ptr_cmp_gt( $cap, $i ) ) {
            my ptr $slot = hash_bucket( $obj, $i );
            my i64 $key  = Brocken::load_i64($slot);
            if ( Brocken::ptr_cmp_eq( $key, 0 ) == 0 && Brocken::ptr_cmp_eq( $key, 1 ) == 0 ) {
                my i64 $val = Brocken::load_i64( Brocken::ptr_add( $slot, 8 ) );
                if ( Brocken::ptr_cmp_gt( $val, 65536 ) && Brocken::ptr_cmp_eq( Brocken::band( $val, 7 ), 0 ) ) {
                    incref($val);
                }
            }
            $i = Brocken::i64_add( $i, 1 );
        }
    }
    elsif ( Brocken::ptr_cmp_eq( $tag, 4 ) ) {
        my i64 $class_id = Brocken::shr( $header, 32 );
        if ( Brocken::ptr_cmp_gt( $class_id, 0 ) ) {
            gc_restore_class($obj);
        }
    }
    return;
}

# Drain the suspect buffer using Bacon/Rajan trial Deletion.
sub gc_drain( ptr $hb ) {

    # Phase 1: Tentative scan
    my ptr $node = get_suspect_buffer_head($hb);
    while ( Brocken::ptr_cmp_eq( $node, 0 ) == 0 ) {
        my ptr $obj       = Brocken::load_i64($node);
        my ptr $next_node = Brocken::load_i64( Brocken::ptr_add( $node, 8 ) );
        gc_scan_obj( $obj, $hb );
        my i64 $rc = Brocken::band( Brocken::load_i64($obj), 65535 );
        if ( Brocken::ptr_cmp_eq( $rc, 0 ) ) {
            my i64 $flags = get_gc_flags($obj);
            set_gc_flags( $obj, Brocken::band( $flags, 231 ) );
        }
        else {
            my i64 $flags = get_gc_flags($obj);
            set_gc_flags( $obj, Brocken::bor( Brocken::band( $flags, 231 ), 24 ) );
        }
        $node = $next_node;
    }

    # Phase 2: Restore refs for Black (reachable) suspects
    my ptr $node2 = get_suspect_buffer_head($hb);
    while ( Brocken::ptr_cmp_eq( $node2, 0 ) == 0 ) {
        my ptr $obj       = Brocken::load_i64($node2);
        my ptr $next_node = Brocken::load_i64( Brocken::ptr_add( $node2, 8 ) );
        my i64 $flags     = get_gc_flags($obj);
        my i64 $color     = Brocken::band( Brocken::shr( $flags, 3 ), 3 );
        if ( Brocken::ptr_cmp_eq( $color, 3 ) ) {
            gc_restore_refs($obj);
            set_gc_flags( $obj, Brocken::bor( Brocken::band( $flags, 231 ), 24 ) );
        }
        $node2 = $next_node;
    }

    # Phase 3: Collect White/Gray objects and free all nodes back to free16
    my ptr $node3 = get_suspect_buffer_head($hb);
    while ( Brocken::ptr_cmp_eq( $node3, 0 ) == 0 ) {
        my ptr $obj       = Brocken::load_i64($node3);
        my ptr $next_node = Brocken::load_i64( Brocken::ptr_add( $node3, 8 ) );
        my i64 $flags     = get_gc_flags($obj);
        my i64 $color     = Brocken::band( Brocken::shr( $flags, 3 ), 3 );
        if ( Brocken::ptr_cmp_eq( $color, 3 ) == 0 ) {
            my i64 $header = Brocken::load_i64($obj);
            my i64 $old_rc = Brocken::band( $header, 65535 );
            Brocken::store_i64( $obj, Brocken::i64_sub( $header, $old_rc ) );
            my ptr $fhead = get_free16_head($hb);
            Brocken::store_i64( Brocken::ptr_add( $obj, 8 ), $fhead );
            set_free16_head( $hb, $obj );
            my ptr $block_base = block_of( $hb, $obj );
            my ptr $lc_ptr     = Brocken::ptr_add( $block_base, block_live_count_offset() );
            my i64 $lc         = Brocken::load_i64($lc_ptr);
            $lc = Brocken::i64_sub( $lc, 1 );
            Brocken::store_i64( $lc_ptr, $lc );

            if ( Brocken::ptr_cmp_eq( $lc, 0 ) ) {
                my ptr $fb_head = get_free_blocks($hb);
                Brocken::store_i64( $block_base, $fb_head );
                set_free_blocks( $hb, $block_base );
            }
        }

        # Free the node back to free16
        my ptr $fhead2 = get_free16_head($hb);
        Brocken::store_i64( Brocken::ptr_add( $node3, 8 ), $fhead2 );
        set_free16_head( $hb, $node3 );
        $node3 = $next_node;
    }
    set_suspect_buffer_head( $hb, 0 );
    return;
}

# Convert a signed i64 to a NUL-terminated decimal string.
sub i64_to_str( ptr $hb, i64 $val ) : returns(ptr) {
    my ptr $buf    = bump_alloc( $hb, 32 );
    my ptr $cursor = $buf;
    my u64 $uval   = $val;
    if ( $val < 0 ) {
        Brocken::store_i8( $cursor, 45 );
        $cursor = Brocken::ptr_add( $cursor, 1 );
        $uval   = 0 - $val;
    }
    my ptr $digits_start = $cursor;
    while (1) {
        my i64 $digit = $uval % 10;
        my i64 $ch    = Brocken::i64_add( $digit, 48 );
        Brocken::store_i8( $cursor, $ch );
        $cursor = Brocken::ptr_add( $cursor, 1 );
        $uval   = $uval / 10;
        if ( $uval == 0 ) { last; }
    }
    my ptr $end = Brocken::ptr_add( $cursor, -1 );
    while ( Brocken::ptr_cmp_lt( $digits_start, $end ) != 0 ) {
        my i8 $a = Brocken::load_i8($digits_start);
        my i8 $b = Brocken::load_i8($end);
        Brocken::store_i8( $digits_start, $b );
        Brocken::store_i8( $end,          $a );
        $digits_start = Brocken::ptr_add( $digits_start,  1 );
        $end          = Brocken::ptr_add( $end,          -1 );
    }
    Brocken::store_i8( $cursor, 0 );
    return $buf;
}

# Convert an unsigned u64 to a NUL-terminated decimal string.
# The parameter is u64 so that `%` and `/` below lower to unsigned division. With an i64 parameter they stayed signed,
# so any value at or above 2^63 produced negative remainders and $digit + 48 wrote bytes outside '0'..'9'.
sub u64_to_str( ptr $hb, u64 $val ) : returns(ptr) {
    my ptr $buf          = bump_alloc( $hb, 32 );
    my ptr $cursor       = $buf;
    my ptr $digits_start = $cursor;
    while (1) {
        my i64 $digit = $val % 10;
        my i64 $ch    = Brocken::i64_add( $digit, 48 );
        Brocken::store_i8( $cursor, $ch );
        $cursor = Brocken::ptr_add( $cursor, 1 );
        $val    = $val / 10;
        if ( $val == 0 ) { last; }
    }
    my ptr $end = Brocken::ptr_add( $cursor, -1 );
    while ( Brocken::ptr_cmp_lt( $digits_start, $end ) != 0 ) {
        my i8 $a = Brocken::load_i8($digits_start);
        my i8 $b = Brocken::load_i8($end);
        Brocken::store_i8( $digits_start, $b );
        Brocken::store_i8( $end,          $a );
        $digits_start = Brocken::ptr_add( $digits_start,  1 );
        $end          = Brocken::ptr_add( $end,          -1 );
    }
    Brocken::store_i8( $cursor, 0 );
    return $buf;
}

sub suspect_count( ptr $hb ) : returns(i64) {
    my ptr $p     = get_suspect_buffer_head($hb);
    my i64 $count = 0;
    while ( Brocken::ptr_cmp_eq( $p, 0 ) == 0 ) {
        $count = Brocken::i64_add( $count, 1 );
        $p     = Brocken::load_i64( Brocken::ptr_add( $p, 8 ) );
    }
    return $count;
}

# Box tag and payload readers
#
# A box is a header word followed by the payload: the header carries the tag in its top byte, so the tag is the header
# shifted down by 24, and the payload starts 8 bytes in. These three are the whole of "what is this dynamic value, and
# what is in it".
sub box_tag( ptr $dyn ) : returns(i64) {
    # A null box is undef and has no header to read a tag from; tag 0 stands for that. Without this the dereference
    # faults, which `builtin::stringify(undef)` and `say` of an undefined value would otherwise hit.
    if ( Brocken::ptr_cmp_eq( $dyn, 0 ) ) {
        return 0;
    }
    my i64 $header = Brocken::load_i64($dyn);
    return Brocken::shr( Brocken::band( $header, 4278190080 ), 24 );
}

# Read a boxed payload as an integer, truncating a float toward zero. A payload narrower than i64 needs no extra care,
# because a narrow read of a wide little-endian payload is exactly a truncation. A null box is undef, which reads as 0
# rather than faulting -- `%h{...}` returns a null box for a missing key, and `return %h{$k}` from an int function then
# unboxes that null.
sub unbox_i64( ptr $dyn ) : returns(i64) {
    if ( Brocken::ptr_cmp_eq( $dyn, 0 ) ) {
        return 0;
    }
    my ptr $payload = Brocken::ptr_add( $dyn, 8 );
    my i64 $tag     = box_tag($dyn);
    if ( $tag == 3 ) {
        my f64 $f = Brocken::load_f64($payload);
        my i64 $n = $f;
        return $n;
    }
    if ( $tag == 1 ) {
        my i32 $n32 = Brocken::load_i32($payload);
        my i64 $n   = $n32;
        return $n;
    }
    return Brocken::load_i64($payload);
}

# Read a boxed payload as a double, widening an integer payload. A null box (undef) reads as 0.0.
sub unbox_f64( ptr $dyn ) : returns(f64) {
    if ( Brocken::ptr_cmp_eq( $dyn, 0 ) ) {
        return 0.0;
    }
    my ptr $payload = Brocken::ptr_add( $dyn, 8 );
    my i64 $tag     = box_tag($dyn);
    if ( $tag == 3 ) {
        return Brocken::load_f64($payload);
    }
    my i64 $n = unbox_i64($dyn);
    my f64 $f = $n;
    return $f;
}

# Read a boxed payload as a pointer -- the characters of a String, or the identity of an instance. A null box (undef)
# reads as the null pointer rather than faulting, for the same reason `unbox_i64` tolerates one.
sub unbox_ptr( ptr $dyn ) : returns(ptr) {
    if ( Brocken::ptr_cmp_eq( $dyn, 0 ) ) {
        return 0;
    }
    my ptr $payload = Brocken::ptr_add( $dyn, 8 );
    return Brocken::load_i64($payload);
}

# Perl truthiness for a boxed value. A null box (undef), an integer or i128 zero, a 0.0 double, the empty string, and
# the one-character string "0" are false; everything else is true -- including the strings "00" and "0.0", the double
# 0.5, and any reference (String, List, Hash, heap array, or class instance). `as_condition` calls this instead of
# blindly unboxing, which both gives the right answer for "0"/"" and avoids dereferencing a null box.
sub is_truthy( ptr $dyn ) : returns(i64) {
    if ( Brocken::ptr_cmp_eq( $dyn, 0 ) ) {
        return 0;
    }
    my i64 $header = Brocken::load_i64($dyn);
    my i64 $tag    = Brocken::band( Brocken::shr( $header, 24 ), 255 );
    if ( $tag == 3 ) {
        my f64 $f = Brocken::load_f64( Brocken::ptr_add( $dyn, 8 ) );
        if ( $f == 0.0 ) { return 0; }
        return 1;
    }
    if ( $tag == 1 ) {
        my i32 $n = Brocken::load_i32( Brocken::ptr_add( $dyn, 8 ) );
        if ( $n == 0 ) { return 0; }
        return 1;
    }
    if ( $tag == 2 ) {
        my i64 $n = Brocken::load_i64( Brocken::ptr_add( $dyn, 8 ) );
        if ( $n == 0 ) { return 0; }
        return 1;
    }
    if ( $tag == 6 ) {
        my i64 $lo = Brocken::load_i64( Brocken::ptr_add( $dyn, 8 ) );
        my i64 $hi = Brocken::load_i64( Brocken::ptr_add( $dyn, 16 ) );
        if ( $lo == 0 && $hi == 0 ) { return 0; }
        return 1;
    }
    if ( $tag == 4 ) {

        # Bits [32..) carry a class id; a nonzero id marks a class instance (a true reference), while zero marks a
        # boxed String whose payload is the NUL-terminated bytes.
        my i64 $class_id = Brocken::shr( $header, 32 );
        if ( Brocken::ptr_cmp_gt( $class_id, 0 ) ) { return 1; }
        my ptr $s  = Brocken::load_i64( Brocken::ptr_add( $dyn, 8 ) );
        my i8  $c0 = Brocken::load_i8($s);
        if ( $c0 == 0 ) { return 0; }
        if ( $c0 == 48 ) {
            my i8 $c1 = Brocken::load_i8( Brocken::ptr_add( $s, 1 ) );
            if ( $c1 == 0 ) { return 0; }
        }
        return 1;
    }
    return 1;
}

# NUL-terminated string concatenation, allocated from the managed heap. This replaces the frontend's old strlen +
# malloc + strcpy + strcat call sequence: a Wasm module emits no import section, so those libc names were undefined
# symbols the linker died on. The strings never need refcounting: the buffer belongs to the caller and the payload it
# holds has no references of its own.
sub str_concat( ptr $hb, ptr $lhs, ptr $rhs ) : returns(ptr) {
    my i64 $llen = 0;
    my ptr $p    = $lhs;
    while (1) {
        my i8 $c = Brocken::load_i8($p);
        if ( $c == 0 ) { last; }
        $llen = Brocken::i64_add( $llen, 1 );
        $p    = Brocken::ptr_add( $p, 1 );
    }
    my i64 $rlen = 0;
    $p = $rhs;
    while (1) {
        my i8 $c = Brocken::load_i8($p);
        if ( $c == 0 ) { last; }
        $rlen = Brocken::i64_add( $rlen, 1 );
        $p    = Brocken::ptr_add( $p, 1 );
    }
    my i64 $total = Brocken::i64_add( Brocken::i64_add( $llen, $rlen ), 1 );
    my ptr $buf   = bump_alloc( $hb, $total );
    my ptr $dst   = $buf;
    $p = $lhs;
    my i64 $i = 0;
    while ( $i < $llen ) {
        my i8 $byte = Brocken::load_i8($p);
        Brocken::store_i8( $dst, $byte );
        $p   = Brocken::ptr_add( $p,   1 );
        $dst = Brocken::ptr_add( $dst, 1 );
        $i   = Brocken::i64_add( $i, 1 );
    }
    $p = $rhs;
    $i = 0;
    while ( $i < $rlen ) {
        my i8 $byte = Brocken::load_i8($p);
        Brocken::store_i8( $dst, $byte );
        $p   = Brocken::ptr_add( $p,   1 );
        $dst = Brocken::ptr_add( $dst, 1 );
        $i   = Brocken::i64_add( $i, 1 );
    }
    Brocken::store_i8( $dst, 0 );
    return $buf;
}

# Whether a byte is ASCII whitespace -- the set `builtin::trim` strips: space, tab, newline, vertical tab, form feed,
# carriage return. Brocken strings are bytes, so the Unicode whitespace Perl's `trim` also handles is out of reach.
sub str_is_space( i8 $c ) : returns(i64) {
    if ( $c == 32 ) { return 1; }
    if ( $c == 9 )  { return 1; }
    if ( $c == 10 ) { return 1; }
    if ( $c == 11 ) { return 1; }
    if ( $c == 12 ) { return 1; }
    if ( $c == 13 ) { return 1; }
    return 0;
}

# `builtin::trim`: a fresh NUL-terminated copy of $s with leading and trailing ASCII whitespace removed. The original
# is untouched, matching `trim` (which is not an in-place edit even under `use builtin`). The result is a managed
# buffer like `str_concat`'s, so it needs no refcount of its own.
sub str_trim( ptr $hb, ptr $s ) : returns(ptr) {
    my ptr $start = $s;
    while ( str_is_space( Brocken::load_i8($start) ) != 0 ) {
        $start = Brocken::ptr_add( $start, 1 );
    }
    my i64 $len = 0;
    my ptr $end = $start;
    while ( Brocken::load_i8($end) != 0 ) {
        $end = Brocken::ptr_add( $end, 1 );
        $len = Brocken::i64_add( $len, 1 );
    }
    while ( $len > 0 ) {
        my ptr $last = Brocken::ptr_add( $start, Brocken::i64_sub( $len, 1 ) );
        if ( str_is_space( Brocken::load_i8($last) ) == 0 ) { last; }
        $len = Brocken::i64_sub( $len, 1 );
    }
    my ptr $buf = bump_alloc( $hb, Brocken::i64_add( $len, 1 ) );
    my ptr $dst = $buf;
    my ptr $src = $start;
    my i64 $i   = 0;
    while ( $i < $len ) {
        Brocken::store_i8( $dst, Brocken::load_i8($src) );
        $src = Brocken::ptr_add( $src, 1 );
        $dst = Brocken::ptr_add( $dst, 1 );
        $i   = Brocken::i64_add( $i, 1 );
    }
    Brocken::store_i8( $dst, 0 );
    return $buf;
}

# Heap Array allocation (tag 9, header [tag|rc] at +0, count at +8, bytes at +16, elements at +24).
# Freed arrays are recycled through the segregated free_big_head list (sized >= request), so loops that re-allocate
# an array each iteration reuse the same slab instead of growing the arena unboundedly.
sub alloc_array( ptr $hb, i64 $count, i64 $elem_size ) : returns(ptr) {
    my i64 $body = $count * $elem_size;
    my i64 $size = $body + 24;            # header(8) + count(8) + bytes(8)

    # Recycle a freed array whose payload bytes are at least what this request needs. The bytes field survives the
    # free (only [obj+8] carries the free-list next pointer), so a scan compares [obj+16] against the request.
    my ptr $prev = 0;
    my ptr $slab = get_free_big_head($hb);
    while ( Brocken::ptr_cmp_eq( $slab, 0 ) == 0 ) {
        my i64 $slab_bytes = Brocken::load_i64( Brocken::ptr_add( $slab, 16 ) );
        if ( Brocken::ptr_cmp_ge( $slab_bytes, $body ) ) {
            my ptr $next = Brocken::load_i64( Brocken::ptr_add( $slab, 8 ) );
            if ( Brocken::ptr_cmp_eq( $prev, 0 ) ) {
                set_free_big_head( $hb, $next );
            }
            else {
                Brocken::store_i64( Brocken::ptr_add( $prev, 8 ), $next );
            }
            Brocken::store_i64( $slab, 0 );    # clear stale header before reuse
            my i64 $header = Brocken::i64_add( 1, Brocken::shl( 9, 24 ) );
            Brocken::store_i64( $slab,                        $header );
            Brocken::store_i64( Brocken::ptr_add( $slab, 8 ), $count );
            return $slab;
        }
        $prev = $slab;
        $slab = Brocken::load_i64( Brocken::ptr_add( $slab, 8 ) );
    }
    my ptr $obj = bump_alloc( $hb, $size );
    if ( Brocken::ptr_cmp_eq( $obj, 0 ) ) {
        return 0;
    }

    # header: refcount 1, tag 9 (Array), flags 0
    my i64 $header = Brocken::i64_add( 1, Brocken::shl( 9, 24 ) );
    Brocken::store_i64( $obj, $header );
    Brocken::store_i64( Brocken::ptr_add( $obj, 8 ),  $count );
    Brocken::store_i64( Brocken::ptr_add( $obj, 16 ), $body );
    return $obj;
}

# Zero the element body of a freshly allocated array. A managed (`Any`) element holds a box pointer and the owning
# store releases whatever it displaces, so the body has to read as null boxes before the first write. Only managed-
# element arrays are zeroed; an i64 array keeps its elements uninitialised (elements start at +24, after the header).
sub array_zero( ptr $arr, i64 $count, i64 $elem_size ) {
    my i64 $bytes = $count * $elem_size;
    my i64 $i     = 0;
    while ( Brocken::ptr_cmp_gt( $bytes, $i ) ) {
        Brocken::store_i64( Brocken::ptr_add( Brocken::ptr_add( $arr, 24 ), $i ), 0 );
        $i = $i + 8;
    }
    return;
}

# Release a heap array whose elements are owned boxes: drop one reference to each element, then to the array block.
# Every managed-element array is zeroed at allocation, so an unwritten element is a null box and its decref is a
# no-op. The owning store balanced each element's reference, so this is the matching release (see _emit_owned_store).
sub array_release( ptr $hb, ptr $arr ) {
    if ( Brocken::ptr_cmp_eq( $arr, 0 ) ) {
        return;
    }
    my i64 $count = Brocken::load_i64( Brocken::ptr_add( $arr, 8 ) );
    my i64 $i     = 0;
    while ( Brocken::ptr_cmp_gt( $count, $i ) ) {
        my ptr $elem = Brocken::load_i64( Brocken::ptr_add( Brocken::ptr_add( $arr, 24 ), $i * 8 ) );
        decref( $elem, $hb );
        $i = $i + 1;
    }
    decref( $arr, $hb );
    return;
}

# Array element accessors for i64 elements (elements start at +24, after header/count/bytes)
sub array_get_i64( ptr $arr, i64 $idx ) : returns(i64) {
    my ptr $base = Brocken::ptr_add( $arr,  24 );
    my ptr $elem = Brocken::ptr_add( $base, $idx * 8 );
    return Brocken::load_i64($elem);
}

sub array_set_i64( ptr $arr, i64 $idx, i64 $val ) {
    my ptr $base = Brocken::ptr_add( $arr,  24 );
    my ptr $elem = Brocken::ptr_add( $base, $idx * 8 );
    Brocken::store_i64( $elem, $val );
    return;
}

# Container mutations for i64 arrays (pass 1 minimal). Every grow/shrink re-allocates the tag-9 block and copies, so a
# call has O(n) cost; the element count is the logical length and the block is sized to fit it exactly.
#
# Grow (`push`/`unshift`) returns the fresh array -- its refcount is the one alloc_array hands back -- after releasing
# the old block, so the caller must store the result back into the array's slot. Shrink (`pop`/`shift`) mutates the
# count in place and returns the removed element (0 when the array is empty, since an i64 element has no undef).
sub array_len( ptr $arr ) : returns(i64) {
    return Brocken::load_i64( Brocken::ptr_add( $arr, 8 ) );
}

sub array_push_i64( ptr $hb, ptr $arr, i64 $val ) : returns(ptr) {
    my i64 $count = Brocken::load_i64( Brocken::ptr_add( $arr, 8 ) );
    my ptr $new   = alloc_array( $hb, $count + 1, 8 );
    my i64 $i     = 0;
    while ( Brocken::ptr_cmp_gt( $count, $i ) ) {
        my i64 $v = array_get_i64( $arr, $i );
        array_set_i64( $new, $i, $v );
        $i = $i + 1;
    }
    array_set_i64( $new, $count, $val );
    decref( $arr, $hb );
    return $new;
}

sub array_unshift_i64( ptr $hb, ptr $arr, i64 $val ) : returns(ptr) {
    my i64 $count = Brocken::load_i64( Brocken::ptr_add( $arr, 8 ) );
    my ptr $new   = alloc_array( $hb, $count + 1, 8 );
    array_set_i64( $new, 0, $val );
    my i64 $i = 0;
    while ( Brocken::ptr_cmp_gt( $count, $i ) ) {
        my i64 $v = array_get_i64( $arr, $i );
        array_set_i64( $new, $i + 1, $v );
        $i = $i + 1;
    }
    decref( $arr, $hb );
    return $new;
}

sub array_pop_i64( ptr $arr ) : returns(i64) {
    my i64 $count = Brocken::load_i64( Brocken::ptr_add( $arr, 8 ) );
    if ( Brocken::ptr_cmp_eq( $count, 0 ) ) {
        return 0;
    }
    my i64 $last = array_get_i64( $arr, $count - 1 );
    Brocken::store_i64( Brocken::ptr_add( $arr, 8 ), $count - 1 );
    return $last;
}

sub array_shift_i64( ptr $arr ) : returns(i64) {
    my i64 $count = Brocken::load_i64( Brocken::ptr_add( $arr, 8 ) );
    if ( Brocken::ptr_cmp_eq( $count, 0 ) ) {
        return 0;
    }
    my i64 $first = array_get_i64( $arr, 0 );
    my i64 $i     = 0;
    while ( Brocken::ptr_cmp_gt( $count - 1, $i ) ) {
        my i64 $next = array_get_i64( $arr, $i + 1 );
        array_set_i64( $arr, $i, $next );
        $i = $i + 1;
    }
    Brocken::store_i64( Brocken::ptr_add( $arr, 8 ), $count - 1 );
    return $first;
}

# == Hash tables (tag 8) ==
# O(1) open addressing with linear probing and tombstones, per spec 6.2. Layout:
#   [0]  header (refcount | tag 8 << 24)
#   [8]  live entry count
#   [16] bucket area bytes (capacity * 16), the size key the free_big list matches on
#   [24] tombstone count
#   [32] buckets: capacity * { key (ptr), value (i64) }
# A bucket key of 0 is empty and ends a probe; 1 is a tombstone and a probe skips it. Capacity is always a power of
# two, kept at or below half full (live + tombstones) by growing to twice the size. Keys are borrowed NUL-terminated
# strings -- a rodata literal or a managed buffer the caller keeps alive -- so only the values are owned. hash_set
# takes ownership of the value it is given and releases whatever it displaces; hash_release releases the values before
# the table itself.

sub hash_capacity( ptr $h ) : returns(i64) {
    return Brocken::shr( Brocken::load_i64( Brocken::ptr_add( $h, 16 ) ), 4 );
}

sub hash_bucket( ptr $h, i64 $idx ) : returns(ptr) {
    return Brocken::ptr_add( $h, Brocken::i64_add( 32, $idx * 16 ) );
}

# djb2 over the NUL-terminated bytes of $s. The caller masks the result into the bucket range.
sub str_hash( ptr $s ) : returns(i64) {
    my i64 $h = 5381;
    my ptr $p = $s;
    while (1) {
        my i64 $c = Brocken::load_i8($p);
        if ( $c == 0 ) { last; }
        $h = Brocken::i64_add( $h * 33, $c );
        $p = Brocken::ptr_add( $p, 1 );
    }
    return $h;
}

sub str_eq( ptr $a, ptr $b ) : returns(i64) {
    my ptr $pa = $a;
    my ptr $pb = $b;
    while (1) {
        my i64 $ca = Brocken::load_i8($pa);
        my i64 $cb = Brocken::load_i8($pb);
        if ( $ca != $cb ) { return 0; }
        if ( $ca == 0 ) { return 1; }
        $pa = Brocken::ptr_add( $pa, 1 );
        $pb = Brocken::ptr_add( $pb, 1 );
    }
}

# Stamp a fresh (or recycled) block as an empty tag-8 table and clear every bucket key.
sub hash_init( ptr $obj, i64 $cap, i64 $body ) : returns(ptr) {
    Brocken::store_i64( $obj, Brocken::i64_add( 1, Brocken::shl( 8, 24 ) ) );
    Brocken::store_i64( Brocken::ptr_add( $obj, 8 ),  0 );
    Brocken::store_i64( Brocken::ptr_add( $obj, 16 ), $body );
    Brocken::store_i64( Brocken::ptr_add( $obj, 24 ), 0 );
    my i64 $i = 0;
    while ( Brocken::ptr_cmp_gt( $cap, $i ) ) {
        Brocken::store_i64( hash_bucket( $obj, $i ), 0 );
        $i = Brocken::i64_add( $i, 1 );
    }
    return $obj;
}

# Allocate a table with $cap buckets (0 for a fresh empty one). Recycles a freed big block like alloc_array, using the
# bytes field at [obj+16] (the bucket area is always capacity * 16 wide) as the size key.
sub hash_alloc( ptr $hb, i64 $cap ) : returns(ptr) {
    my i64 $body = $cap * 16;
    my i64 $size = Brocken::i64_add( $body, 32 );
    my ptr $prev = 0;
    my ptr $slab = get_free_big_head($hb);
    while ( Brocken::ptr_cmp_eq( $slab, 0 ) == 0 ) {
        my i64 $slab_bytes = Brocken::load_i64( Brocken::ptr_add( $slab, 16 ) );
        if ( Brocken::ptr_cmp_ge( $slab_bytes, $body ) ) {
            my ptr $next = Brocken::load_i64( Brocken::ptr_add( $slab, 8 ) );
            if ( Brocken::ptr_cmp_eq( $prev, 0 ) ) {
                set_free_big_head( $hb, $next );
            }
            else {
                Brocken::store_i64( Brocken::ptr_add( $prev, 8 ), $next );
            }
            return hash_init( $slab, $cap, $body );
        }
        $prev = $slab;
        $slab = Brocken::load_i64( Brocken::ptr_add( $slab, 8 ) );
    }
    my ptr $obj = bump_alloc( $hb, $size );
    if ( Brocken::ptr_cmp_eq( $obj, 0 ) ) {
        return 0;
    }
    return hash_init( $obj, $cap, $body );
}

sub hash_new( ptr $hb ) : returns(ptr) {
    return hash_alloc( $hb, 0 );
}

sub hash_len( ptr $h ) : returns(i64) {
    return Brocken::load_i64( Brocken::ptr_add( $h, 8 ) );
}

# The bucket index holding $key, or -1. A tombstone keeps the probe alive; an empty bucket ends it.
sub hash_find( ptr $h, ptr $key ) : returns(i64) {
    my i64 $cap = hash_capacity($h);
    if ( $cap == 0 ) { return -1; }
    my i64 $mask = Brocken::i64_sub( $cap, 1 );
    my i64 $idx  = Brocken::band( str_hash($key), $mask );
    my i64 $step = 0;
    while ( Brocken::ptr_cmp_gt( $cap, $step ) ) {
        my ptr $slot = hash_bucket( $h, $idx );
        my ptr $k    = Brocken::load_i64($slot);
        if ( Brocken::ptr_cmp_eq( $k, 0 ) ) { return -1; }
        # `&&` is bitwise in Brocken, so both operands are always evaluated: `str_eq(1, $key)` would dereference the
        # tombstone sentinel. Test the sentinel first with a nested `if` so `str_eq` only sees a real key pointer.
        if ( Brocken::ptr_cmp_eq( $k, 1 ) == 0 ) {
            if ( str_eq( $k, $key ) != 0 ) {
                return $idx;
            }
        }
        $idx  = Brocken::band( $idx + 1, $mask );
        $step = Brocken::i64_add( $step, 1 );
    }
    return -1;
}

# Move every live entry of $h into a table twice its size (8 buckets when it was empty) and release the old table. The
# values are moved as-is -- their ownership passes to the new buckets -- so the old table is dropped with a plain
# decref, which does not touch them.
sub hash_grow( ptr $hb, ptr $h ) : returns(ptr) {
    my i64 $cap     = hash_capacity($h);
    my i64 $new_cap = 8;
    if ( $cap > 0 ) { $new_cap = $cap * 2; }
    my ptr $new = hash_alloc( $hb, $new_cap );
    my i64 $i = 0;
    while ( Brocken::ptr_cmp_gt( $cap, $i ) ) {
        my ptr $slot = hash_bucket( $h, $i );
        my ptr $k    = Brocken::load_i64($slot);
        if ( Brocken::ptr_cmp_eq( $k, 0 ) == 0 && Brocken::ptr_cmp_eq( $k, 1 ) == 0 ) {
            $new = hash_set( $hb, $new, $k, Brocken::load_i64( Brocken::ptr_add( $slot, 8 ) ) );
        }
        $i = Brocken::i64_add( $i, 1 );
    }
    decref( $h, $hb );
    return $new;
}

# Insert or replace $key, taking ownership of $val (releasing any displaced value) and returning the table, which a
# grow may have reallocated.
sub hash_set( ptr $hb, ptr $h, ptr $key, ptr $val ) : returns(ptr) {
    my i64 $cap  = hash_capacity($h);
    my i64 $live = Brocken::load_i64( Brocken::ptr_add( $h, 8 ) );
    my i64 $tomb = Brocken::load_i64( Brocken::ptr_add( $h, 24 ) );
    if ( $cap == 0 || ( ( $live + $tomb + 1 ) * 2 ) > $cap ) {
        $h = hash_grow( $hb, $h );
    }
    my i64 $mask       = Brocken::i64_sub( hash_capacity($h), 1 );
    my i64 $idx        = Brocken::band( str_hash($key), $mask );
    my i64 $first_tomb = -1;
    while (1) {
        my ptr $slot = hash_bucket( $h, $idx );
        my ptr $k    = Brocken::load_i64($slot);
        if ( Brocken::ptr_cmp_eq( $k, 0 ) ) {
            my i64 $where = $idx;
            if ( $first_tomb >= 0 ) { $where = $first_tomb; }
            my ptr $dst = hash_bucket( $h, $where );
            Brocken::store_i64( $dst, $key );
            Brocken::store_i64( Brocken::ptr_add( $dst, 8 ), $val );
            Brocken::store_i64( Brocken::ptr_add( $h, 8 ), Brocken::i64_add( Brocken::load_i64( Brocken::ptr_add( $h, 8 ) ), 1 ) );
            if ( $first_tomb >= 0 ) {
                Brocken::store_i64( Brocken::ptr_add( $h, 24 ), Brocken::i64_sub( Brocken::load_i64( Brocken::ptr_add( $h, 24 ) ), 1 ) );
            }
            return $h;
        }
        if ( Brocken::ptr_cmp_eq( $k, 1 ) ) {
            if ( $first_tomb < 0 ) { $first_tomb = $idx; }
        }
        elsif ( str_eq( $k, $key ) != 0 ) {
            my i64 $old = Brocken::load_i64( Brocken::ptr_add( $slot, 8 ) );
            Brocken::store_i64( Brocken::ptr_add( $slot, 8 ), $val );
            decref( $old, $hb );
            return $h;
        }
        $idx = Brocken::band( $idx + 1, $mask );
    }
}

sub hash_get( ptr $h, ptr $key ) : returns(ptr) {
    my i64 $idx = hash_find( $h, $key );
    if ( $idx < 0 ) { return 0; }
    return Brocken::load_i64( Brocken::ptr_add( hash_bucket( $h, $idx ), 8 ) );
}

sub hash_has( ptr $h, ptr $key ) : returns(i64) {
    if ( hash_find( $h, $key ) < 0 ) { return 0; }
    return 1;
}

# Remove $key and transfer ownership of the deleted value to the caller (it is not released here). A free bucket
# becomes a tombstone so later probes into the cluster stay alive.
sub hash_delete( ptr $hb, ptr $h, ptr $key ) : returns(ptr) {
    my i64 $idx = hash_find( $h, $key );
    if ( $idx < 0 ) { return 0; }
    my ptr $slot = hash_bucket( $h, $idx );
    my i64 $old  = Brocken::load_i64( Brocken::ptr_add( $slot, 8 ) );
    Brocken::store_i64( $slot, 1 );
    Brocken::store_i64( Brocken::ptr_add( $slot, 8 ), 0 );
    Brocken::store_i64( Brocken::ptr_add( $h, 8 ), Brocken::i64_sub( Brocken::load_i64( Brocken::ptr_add( $h, 8 ) ), 1 ) );
    Brocken::store_i64( Brocken::ptr_add( $h, 24 ), Brocken::i64_add( Brocken::load_i64( Brocken::ptr_add( $h, 24 ) ), 1 ) );
    return $old;
}

# Release a table at the end of its owner's life: when this is the last reference, release every stored value and then
# the table itself. A table that is still shared only drops its own reference, leaving the values for the other owner.
sub hash_release( ptr $hb, ptr $h ) {
    if ( Brocken::ptr_cmp_eq( $h, 0 ) ) { return; }
    my i64 $rc = Brocken::band( Brocken::load_i64($h), 65535 );
    if ( Brocken::ptr_cmp_eq( $rc, 1 ) ) {
        my i64 $cap = hash_capacity($h);
        my i64 $i   = 0;
        while ( Brocken::ptr_cmp_gt( $cap, $i ) ) {
            my ptr $slot = hash_bucket( $h, $i );
            my ptr $k    = Brocken::load_i64($slot);
            if ( Brocken::ptr_cmp_eq( $k, 0 ) == 0 && Brocken::ptr_cmp_eq( $k, 1 ) == 0 ) {
                decref( Brocken::load_i64( Brocken::ptr_add( $slot, 8 ) ), $hb );
            }
            $i = Brocken::i64_add( $i, 1 );
        }
    }
    decref( $h, $hb );
}
