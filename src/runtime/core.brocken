# Heap Array allocation (pass 1: i64 elements, tag 9, header [tag|rc] at +0, count at +8, elements at +16)
sub Brocken::Runtime::alloc_array( ptr $hb, i64 $count, i64 $elem_size )->ptr {
    my i64 $body  = $count * $elem_size;
    my i64 $size  = $body + 16;  # header(8) + count(8)
    my ptr $obj   = Brocken::Runtime::bump_alloc( $hb, $size );
    if ( Brocken::ptr_cmp_eq( $obj, 0 ) ) {
        return 0;
    }
    # header: refcount 1, tag 9 (Array), flags 0
    my i64 $header = Brocken::i64_add( 1, Brocken::shl( 9, 24 ) );
    Brocken::store_i64( $obj, $header );
    Brocken::store_i64( Brocken::ptr_add( $obj, 8 ), $count );
    return $obj;
}

# Array element accessors for i64 elements
sub Brocken::Runtime::array_get_i64( ptr $arr, i64 $idx )->i64 {
    my ptr $base = Brocken::ptr_add( $arr, 16 );
    my ptr $elem = Brocken::ptr_add( $base, $idx * 8 );
    return Brocken::load_i64($elem);
}

sub Brocken::Runtime::array_set_i64( ptr $arr, i64 $idx, i64 $val ) {
    my ptr $base = Brocken::ptr_add( $arr, 16 );
    my ptr $elem = Brocken::ptr_add( $base, $idx * 8 );
    Brocken::store_i64( $elem, $val );
    return;
}

# Push/pop for i64 arrays (pass 1 minimal)
sub Brocken::Runtime::array_push_i64( ptr $hb, ptr $arr, i64 $val )->i64 {
    my i64 $count = Brocken::load_i64( Brocken::ptr_add( $arr, 8 ) );
    my ptr $new   = Brocken::Runtime::alloc_array( $hb, $count + 1, 8 );
    my i64 $i     = 0;
    while ( Brocken::ptr_cmp_gt( $count, $i ) ) {
        my i64 $v = Brocken::Runtime::array_get_i64( $arr, $i );
        Brocken::Runtime::array_set_i64( $new, $i, $v );
        $i = $i + 1;
    }
    Brocken::Runtime::array_set_i64( $new, $count, $val );
    Brocken::Runtime::decref( $arr, $hb );
    return $new;
}

sub Brocken::Runtime::array_pop_i64( ptr $arr )->i64 {
    my i64 $count = Brocken::load_i64( Brocken::ptr_add( $arr, 8 ) );
    if ( Brocken::ptr_cmp_eq( $count, 0 ) ) {
        return 0;  # or error; keep simple for pass 1
    }
    my i64 $last  = Brocken::Runtime::array_get_i64( $arr, $count - 1 );
    Brocken::store_i64( Brocken::ptr_add( $arr, 8 ), $count - 1 );
    return $last;
}
