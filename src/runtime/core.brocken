# core.brocken -- Brocken v0.1 Runtime Primitives
# Automatically compiled alongside user code.

# Initialize heap metadata in the first 16 bytes of the heap buffer:
#   [heap_base + 0] = cursor (ptr to next free byte, starts at heap_base + 16)
#   [heap_base + 8] = limit (ptr past end of heap)
sub Brocken::Runtime::_init(ptr $heap_base, i64 $heap_size) {
    my ptr $initial_cursor = Brocken::ptr_add($heap_base, 16);
    Brocken::store_i64($heap_base, $initial_cursor);
    my ptr $limit_addr = Brocken::ptr_add($heap_base, 8);
    Brocken::store_i64($limit_addr, Brocken::ptr_add($heap_base, $heap_size));
    return;
}

# Bump-allocate $size bytes from the heap at $heap_base.
# Returns pointer to the allocated block, or 0 on out-of-memory.
sub Brocken::Runtime::bump_alloc(ptr $heap_base, i64 $size) -> ptr {
    my ptr $cursor_ptr = $heap_base;
    my ptr $cursor = Brocken::load_i64($cursor_ptr);
    my ptr $limit = Brocken::load_i64(Brocken::ptr_add($heap_base, 8));
    my ptr $result = $cursor;
    my ptr $new_cursor = Brocken::ptr_add($cursor, $size);
    if (Brocken::ptr_cmp_gt($new_cursor, $limit)) {
        return 0;
    }
    Brocken::store_i64($cursor_ptr, $new_cursor);
    return $result;
}

# Increment the reference count of a fat scalar at $obj.
# The refcount is a u16 at offset 0 of the 16-byte header.
sub Brocken::Runtime::incref(ptr $obj) {
    if (Brocken::ptr_cmp_eq($obj, 0)) {
        return;
    }
    my i64 $header = Brocken::load_i64($obj);
    my i64 $old_rc = Brocken::band($header, 65535);
    my i64 $new_rc = Brocken::i64_add($old_rc, 1);
    if (Brocken::ptr_cmp_gt($new_rc, 65535)) {
        $new_rc = 65535;
    }
    Brocken::store_i64($obj, Brocken::i64_add(Brocken::i64_sub($header, $old_rc), $new_rc));
    return;
}

# Decrement the reference count of a fat scalar at $obj.
# If RC reaches 0, the memory will be reclaimed on the next Immix sweep.
sub Brocken::Runtime::decref(ptr $obj) {
    if (Brocken::ptr_cmp_eq($obj, 0)) {
        return;
    }
    my i64 $header = Brocken::load_i64($obj);
    my i64 $old_rc = Brocken::band($header, 65535);
    my i64 $new_rc = Brocken::i64_sub($old_rc, 1);
    Brocken::store_i64($obj, Brocken::i64_add(Brocken::i64_sub($header, $old_rc), $new_rc));
    return;
}
